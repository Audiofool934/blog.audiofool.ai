{
  "name": "audiofool-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "blog.audiofool.ai, a personal archive for notes, music, photography, and projects, built with Astro.",
  "author": "Audiofool (https://blog.audiofool.ai)",
  "license": "MIT",
  "homepage": "https://blog.audiofool.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Audiofool934/blog.audiofool.ai.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/generate-site-images.mjs && node scripts/generate-audioshow-images.mjs",
    "build": "rm -rf .astro node_modules/.astro && astro build",
    "prebuild": "node scripts/generate-site-images.mjs && node scripts/generate-audioshow-images.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:audioshow-parser": "node --experimental-strip-types scripts/check-audioshow-parser.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "generate:site-images": "node scripts/generate-site-images.mjs",
    "generate:audioshow-images": "node scripts/generate-audioshow-images.mjs",
    "refresh:github-projects": "node scripts/sync-github-projects.mjs",
    "build:with-sync": "npm run refresh:github-projects && npm run build",
    "gallery:intake": "node scripts/gallery-intake/server.mjs",
    "check:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check": "astro check && npm run check:audioshow-parser && npm run check:unit"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@tabler/icons-astro": "^3.46.0",
    "astro": "^6.4.8",
    "autoprefixer": "^10.4.27",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.4",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.0.3",
    "playwright": "^1.63.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  }
}
