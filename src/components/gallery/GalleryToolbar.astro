---
import { IconChevronDown } from "@tabler/icons-astro";

interface Props {
    total: number;
    featuredCount: number;
    categories: readonly string[];
}
const { total, featuredCount, categories } = Astro.props;
---

<div id="gallery-filters" hidden>
    <div class="gallery-toolbar scroll-row">
        <div class="gallery-views" role="group" aria-label="Photo selection">
            <button type="button" data-gallery-view="all" aria-pressed="true" class="gallery-filter-button"><span aria-hidden="true">[ </span>All photos<span aria-hidden="true"> ]</span></button>
            {featuredCount > 0 && (
                <button type="button" data-gallery-view="featured" aria-pressed="false" class="gallery-filter-button"><span aria-hidden="true">[ </span>Featured<span aria-hidden="true"> ]</span></button>
            )}
        </div>
        <div id="gallery-sort-controls" class="gallery-sort" hidden>
            <label for="gallery-sort-order" class="gallery-sort-label">Sort</label>
            <div class="gallery-sort-select">
                <select id="gallery-sort-order" name="order" aria-label="Sort photos">
                    <option value="newest">Newest</option>
                    <option value="oldest">Oldest</option>
                    <option value="location">Location</option>
                    <option value="shuffle">Shuffle</option>
                </select>
                <IconChevronDown size={16} stroke={1.5} aria-hidden="true" />
            </div>
            <button type="button" id="gallery-reshuffle" hidden>Reshuffle</button>
            <span id="gallery-sort-status" class="sr-only" role="status"></span>
        </div>
    </div>
    <div class="gallery-subjects" role="group" aria-labelledby="gallery-subject-label">
        <span id="gallery-subject-label" class="gallery-subject-label">Subject</span>
        <div class="gallery-subject-options scroll-row">
            <button type="button" data-gallery-subject="all" aria-pressed="true" class="gallery-filter-button gallery-subject-button"><span aria-hidden="true">[ </span>All<span aria-hidden="true"> ]</span></button>
            {categories.map((name) => (
                <button type="button" data-gallery-subject={name} aria-pressed="false" class="gallery-filter-button gallery-subject-button"><span aria-hidden="true">[ </span>{name}<span aria-hidden="true"> ]</span></button>
            ))}
        </div>
    </div>
</div>
<div class="gallery-results">
    <p id="gallery-filter-status" class="sr-only" role="status" aria-atomic="true">Showing {total} photos</p>
    <button type="button" id="gallery-filter-reset" hidden>Clear filters</button>
</div>
<p id="gallery-filter-empty" class="gallery-empty" hidden></p>

<script>
    import "../../scripts/galleryFilters";
    import "../../scripts/gallerySort";
</script>

<style>
    #gallery-filters[hidden],
    #gallery-sort-controls[hidden],
    #gallery-filter-reset[hidden],
    #gallery-reshuffle[hidden],
    #gallery-filter-empty[hidden] {
        display: none;
    }

    /* Both rows are .scroll-row (global.css): one scrolling line on phones, wrapping from md up. */
    .gallery-toolbar {
        align-items: center;
        justify-content: space-between;
    }
    @media (min-width: 768px) {
        .gallery-toolbar {
            column-gap: 1.5rem;
            /* A wrapped sort row clears the focus ring of the row above. */
            row-gap: 0.75rem;
            padding-bottom: 0.25rem;
        }
    }

    .gallery-views {
        display: flex;
        gap: 0.75rem;
    }

    /*
     * A button centres its own content within min-height; flex would turn the
     * bracket spans into separate items and drop the spaces inside them.
     */
    .gallery-filter-button {
        min-height: 44px;
        padding: 0.5rem 0;
        text-align: left;
        white-space: nowrap;
        font-size: 0.875rem;
        color: var(--text-muted);
        transition: color 150ms;
    }

    .gallery-filter-button:hover,
    .gallery-sort select:hover,
    .gallery-results button:hover,
    #gallery-reshuffle:hover {
        color: var(--text-main);
    }

    .gallery-filter-button[aria-pressed="true"] {
        color: var(--text-main);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
    }

    .gallery-toolbar,
    .gallery-subjects,
    .gallery-results {
        font-family: var(--font-mono, "JetBrains Mono", monospace);
    }

    .gallery-sort {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: auto;
        font-size: 0.875rem;
        color: var(--text-muted);
    }

    .gallery-sort-select {
        position: relative;
    }

    .gallery-sort select {
        appearance: none;
        min-height: 44px;
        padding: 0.5rem 1.75rem 0.5rem 0.5rem;
        border: 0;
        border-radius: 0;
        cursor: pointer;
        background: var(--bg-body);
        color: var(--text-main);
    }

    .gallery-sort-select :global(svg) {
        position: absolute;
        right: 0.25rem;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    #gallery-reshuffle {
        min-height: 44px;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .gallery-subjects {
        padding-top: 1rem;
        padding-bottom: 0.25rem;
    }

    /* Same style as the homepage "Selected" label. */
    .gallery-sort-label,
    .gallery-subject-label {
        color: var(--text-muted);
        font-size: 0.75rem;
        line-height: 1rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .gallery-subject-label {
        display: block;
        margin-bottom: 0.25rem;
    }

    .gallery-subject-options {
        align-items: stretch;
    }
    @media (min-width: 768px) {
        .gallery-subject-options {
            row-gap: 0.25rem;
        }
    }

    .gallery-results {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        column-gap: 1rem;
        /* Reserved so the grid does not move when "Clear filters" appears. */
        min-height: 2.75rem;
        color: var(--text-muted);
        font-size: 0.875rem;
    }

    .gallery-results button {
        min-height: 36px;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .gallery-empty {
        padding: 2rem 0;
        color: var(--text-muted);
    }

    @media (max-width: 639px) {
        .gallery-sort-label {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
        }
        .gallery-sort {
            gap: 0.25rem;
        }
        /* The Sort label is hidden here, so the select needs no left inset and fits beside the views. */
        .gallery-sort select {
            padding-left: 0;
        }
        .gallery-subjects {
            padding-top: 0.75rem;
        }
    }
</style>
