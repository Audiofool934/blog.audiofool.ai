---
interface Props {
    id: string;
}

const { id } = Astro.props;
---

<button
    id={id}
    type="button"
    data-theme-toggle
    class="theme-toggle font-mono text-sm"
    aria-label="Switch to light theme"
    title="Switch to light theme"
>
    <svg class="theme-toggle__glyph theme-toggle__glyph--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 13A8.5 8.5 0 1 1 11 3.5 6.5 6.5 0 0 0 20.5 13Z" />
    </svg>
    <svg class="theme-toggle__glyph theme-toggle__glyph--sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
    </svg>
</button>

<style>
    .theme-toggle {
        display: inline-flex;
        height: 30px;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        padding: 0 8px;
        border: 1px solid transparent;
        color: var(--text-main);
        transition: opacity 150ms ease;
    }

    /* Match Tailwind's hoverOnlyWhenSupported so a tap does not leave the toggle dimmed. */
    @media (hover: hover) and (pointer: fine) {
        .theme-toggle:hover {
            opacity: 0.6;
        }
    }

    .theme-toggle:focus-visible {
        outline: 2px solid var(--text-main);
        outline-offset: 3px;
    }

    .theme-toggle__glyph {
        flex: none;
    }

    .theme-toggle__glyph--sun,
    :global(html.dark) .theme-toggle__glyph--moon {
        display: none;
    }

    :global(html.dark) .theme-toggle__glyph--sun {
        display: block;
    }

    @media (prefers-reduced-motion: reduce) {
        .theme-toggle {
            transition: none;
        }
    }
</style>
