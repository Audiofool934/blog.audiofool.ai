---
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { getCollection } from "astro:content";
import { formatDateCompact } from "../../utils/formatDate";
import githubProjects from "../../data/github-projects.json";
import { getProjectState, isExternalUrl, uniqueLabels } from "../../utils/projectState";

const projects = await getCollection("projects");
const projectState = (project: (typeof projects)[number]) => getProjectState(project, githubProjects.projects);

const sortedProjects = [...projects].sort(
    (a, b) => projectState(b).date.valueOf() - projectState(a).date.valueOf(),
);

const pinnedProjects = sortedProjects
    .filter((project) => project.data.pinned)
    .sort((a, b) => (a.data.pinOrder ?? Infinity) - (b.data.pinOrder ?? Infinity));
const latestProjects = sortedProjects.slice(0, 8);

const categorizedProjects = sortedProjects.reduce(
    (acc, project) => {
        const cat = project.data.category || "Other";
        if (!acc[cat]) acc[cat] = [];
        acc[cat].push(project);
        return acc;
    },
    {} as Record<string, typeof projects>,
);

// One-word classes in display order; any other category follows them in the All view.
const categoryOrder = ["Music", "Agent", "Tool", "Art", "Web", "Coursework"];
const sortedCategories = Object.keys(categorizedProjects).sort((a, b) => {
    const indexA = categoryOrder.indexOf(a);
    const indexB = categoryOrder.indexOf(b);
    return (indexA === -1 ? 999 : indexA) - (indexB === -1 ? 999 : indexB);
});

// A class view narrows the All panel to one category; ?view=<class> deep-links to it.
const classView = (category: string) => category.toLowerCase();
// Filters name countable classes in the plural, like the Timeline's [ Notes ].
const classLabels: Record<string, string> = { Agent: "Agents", Tool: "Tools" };
const classFilters = categoryOrder
    .filter((category) => categorizedProjects[category])
    .map((category) => ({ view: classView(category), label: classLabels[category] ?? category }));

// Pinned projects link to their own sites; mark those rows so they don't pass for internal pages.
const siteOrigin = Astro.site?.origin;
---

<MinimalLayout
    title="Projects | Audiofool"
    description="Welcome to the Machine"
>
    <div class="p-6 md:p-12" transition:animate="fade">
        <header class="mb-10">
            <h1 class="text-4xl font-bold font-heading mb-2">Projects</h1>
            <p class="font-mono text-sm text-[var(--text-muted)]">
                Welcome to the Machine
            </p>
        </header>

        {
            pinnedProjects.length > 0 && (
                <section class="mb-16">
                    <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--text-muted)] mb-3">
                        Pinned
                    </h2>

                    <div class="grid gap-x-10 gap-y-8 lg:grid-cols-2">
                        {pinnedProjects.map((project) => {
                            const state = projectState(project);
                            const external = isExternalUrl(state.href, siteOrigin);
                            return (
                                <a href={state.href} class="group block">
                                    {/* A no-break space before each "·" keeps the dot off the start of a wrapped line. */}
                                    <p class="font-mono text-xs uppercase tracking-wider text-[var(--text-faint)]">
                                        <time datetime={state.date.toISOString()}>{formatDateCompact(state.date)}</time>{uniqueLabels([project.data.category, state.status, state.fork ? "fork" : ""]).map((label) => <>{"\u00a0· "}<span class="whitespace-nowrap">{label}</span></>)}
                                    </p>
                                    <h3 class="mt-2 text-lg font-bold font-heading text-[var(--text-main)] group-hover:underline decoration-1 underline-offset-4">
                                        {project.data.title}
                                        {external && <span aria-hidden="true"> ↗</span>}
                                        {external && <span class="sr-only"> (external)</span>}
                                    </h3>
                                    <p class="mt-1 text-sm leading-relaxed text-[var(--text-muted)]">
                                        {project.data.description}
                                    </p>
                                </a>
                            );
                        })}
                    </div>
                </section>
            )
        }

        <section>
            {/* On phones the label and filters are one scrolling row; wider, the label heads the row and wrapped filters align after it. */}
            <div class="mb-6">
                <div class="scroll-row font-mono">
                    <h2 id="project-index-label" class="shrink-0 text-xs uppercase tracking-widest text-[var(--text-muted)]">
                        Project Index
                    </h2>
                    <div role="group" aria-labelledby="project-index-label" class="flex gap-3 md:flex-1 md:min-w-0 md:flex-wrap">
                        <button
                            type="button"
                            data-view="latest"
                            aria-pressed="true"
                            class="project-view-filter active whitespace-nowrap text-sm py-1.5 -my-1.5 transition-colors"
                        >
                            <span aria-hidden="true">[ </span>Latest<span aria-hidden="true"> ]</span>
                        </button>
                        <button
                            type="button"
                            data-view="all"
                            aria-pressed="false"
                            class="project-view-filter whitespace-nowrap text-sm py-1.5 -my-1.5 transition-colors"
                        >
                            <span aria-hidden="true">[ </span>All<span aria-hidden="true"> ]</span>
                        </button>
                        {classFilters.map(({ view, label }) => (
                            <button
                                type="button"
                                data-view={view}
                                aria-pressed="false"
                                class="project-view-filter whitespace-nowrap text-sm py-1.5 -my-1.5 transition-colors"
                            >
                                <span aria-hidden="true">[ </span>{label}<span aria-hidden="true"> ]</span>
                            </button>
                        ))}
                    </div>
                </div>
            </div>

            <div data-project-view="latest" class="project-view-panel spine max-w-2xl">
                {latestProjects.map((project) => {
                    const state = projectState(project);
                    const external = isExternalUrl(state.href, siteOrigin);
                    return (
                        <a href={state.href} class="group relative block mb-8">
                            <span aria-hidden="true" class="spine-dot" />
                            {/* Only an archived status or a fork is worth a word here; Pinned and All show every status. */}
                            <p class="font-mono text-xs uppercase tracking-wider text-[var(--text-faint)]">
                                <time datetime={state.date.toISOString()}>{formatDateCompact(state.date)}</time>{uniqueLabels([project.data.category, state.status === "archived" ? state.status : "", state.fork ? "fork" : ""]).map((label) => <>{"\u00a0· "}<span class="whitespace-nowrap">{label}</span></>)}
                            </p>
                            <h3 class="mt-2 font-sans text-base font-semibold text-[var(--text-main)] group-hover:underline decoration-1 underline-offset-4">
                                {project.data.title}
                                {external && <span aria-hidden="true"> ↗</span>}
                                {external && <span class="sr-only"> (external)</span>}
                            </h3>
                            {/* Pinned projects already show their description above. */}
                            {project.data.description && !project.data.pinned && (
                                <p class="mt-1 font-sans text-sm leading-relaxed text-[var(--text-muted)]">
                                    {project.data.description}
                                </p>
                            )}
                        </a>
                    );
                })}
            </div>

            <div data-project-view="all" class="project-view-panel hidden max-w-2xl">
                {sortedCategories.map((category) => (
                    <section class="mb-12" data-category={classView(category)}>
                        {/* Rows are spaced by margin so a focus ring wraps only the row; open:pb-8 keeps the gap after the last row. */}
                        <details open class="open:pb-8">
                            <summary class="cursor-pointer list-none flex items-center justify-between mb-5">
                                <h3 class="text-lg font-bold font-heading">
                                    {category}
                                </h3>
                                <span class="font-mono text-xs text-[var(--text-muted)]">
                                    ↓
                                </span>
                            </summary>

                            <div class="spine">
                                {categorizedProjects[category].map((project) => {
                                    const state = projectState(project);
                                    const external = isExternalUrl(state.href, siteOrigin);
                                    return (
                                        <a href={state.href} class="group relative block mb-8 last:mb-0">
                                            <span aria-hidden="true" class="spine-dot" />
                                            {/* The category heading above, or the class filter, already names the category. */}
                                            <p class="font-mono text-xs uppercase tracking-wider text-[var(--text-faint)]">
                                                <time datetime={state.date.toISOString()}>{formatDateCompact(state.date)}</time>{uniqueLabels([state.status, state.fork ? "fork" : ""], [category]).map((label) => <>{"\u00a0· "}<span class="whitespace-nowrap">{label}</span></>)}
                                            </p>
                                            <h4 class="mt-2 font-sans text-base font-semibold text-[var(--text-main)] group-hover:underline decoration-1 underline-offset-4">
                                                {project.data.title}
                                                {external && <span aria-hidden="true"> ↗</span>}
                                                {external && <span class="sr-only"> (external)</span>}
                                            </h4>
                                            {project.data.description && (
                                                <p class="mt-1 font-sans text-sm leading-relaxed text-[var(--text-muted)]">
                                                    {project.data.description}
                                                </p>
                                            )}
                                        </a>
                                    );
                                })}
                            </div>
                        </details>
                    </section>
                ))}
            </div>
        </section>

        {
            sortedProjects.length === 0 && (
                <div class="py-12 text-center text-[var(--text-muted)]">
                    No projects found. New machines are being built.
                </div>
            )
        }
    </div>
</MinimalLayout>

<style>
    .project-view-filter {
        color: var(--text-muted);
    }
    .project-view-filter:hover {
        color: var(--text-main);
    }
    .project-view-filter.active {
        color: var(--text-main);
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-thickness: 1px;
    }
</style>

<script>
    import { revealInRow } from "../../scripts/scrollRow";

    (function () {
        let cleanupFn: (() => void) | null = null;

        document.addEventListener("astro:page-load", () => {
            if (cleanupFn) {
                cleanupFn();
                cleanupFn = null;
            }

            const filters = document.querySelectorAll<HTMLElement>(".project-view-filter");
            const panels = document.querySelectorAll<HTMLElement>(".project-view-panel");
            const sections = document.querySelectorAll<HTMLElement>('[data-project-view="all"] [data-category]');
            if (!filters.length || !panels.length) return;
            const views = new Set(Array.from(filters, (filter) => filter.dataset.view));

            function applyView(view: string) {
                filters.forEach((item) => {
                    item.classList.remove("active");
                    item.setAttribute("aria-pressed", "false");
                });
                const btn = document.querySelector(
                    '.project-view-filter[data-view="' + view + '"]',
                );
                if (btn) {
                    btn.classList.add("active");
                    btn.setAttribute("aria-pressed", "true");
                    revealInRow(btn);
                }

                // A class view is the All panel with only that category's section, open and without its heading.
                const category = view === "latest" || view === "all" ? null : view;
                panels.forEach((panel) => {
                    panel.classList.toggle("hidden", panel.dataset.projectView !== (category ? "all" : view));
                });
                sections.forEach((section) => {
                    const details = section.querySelector("details");
                    const summary = details?.querySelector("summary");
                    if (!details || !summary) return;
                    const shown = !category || section.dataset.category === category;
                    section.classList.toggle("hidden", !shown);
                    summary.classList.toggle("hidden", category !== null);
                    if (category && shown) {
                        // Keep the reader's open or closed choice for the All view.
                        if (details.dataset.allOpen === undefined) details.dataset.allOpen = String(details.open);
                        details.open = true;
                    } else if (!category && details.dataset.allOpen !== undefined) {
                        details.open = details.dataset.allOpen === "true";
                        delete details.dataset.allOpen;
                    }
                });
            }

            function onClick(e: Event) {
                if (!(e.currentTarget instanceof HTMLElement)) return;
                applyView(e.currentTarget.dataset.view || "latest");
            }

            filters.forEach((filter) => {
                filter.addEventListener("click", onClick);
            });

            // ?view=all or ?view=<class> selects that view; anything else stays on Latest.
            const urlView = new URLSearchParams(window.location.search).get("view")?.toLowerCase();
            if (urlView && views.has(urlView)) applyView(urlView);

            cleanupFn = function () {
                filters.forEach((filter) =>
                    filter.removeEventListener("click", onClick),
                );
            };
        });
    })();
</script>
