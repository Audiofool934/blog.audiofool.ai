---
import { getCollection, render } from "astro:content";
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import githubProjects from "../../data/github-projects.json";
import { formatDateLong } from "../../utils/formatDate";
import { getProjectState, isExternalUrl, uniqueLabels } from "../../utils/projectState";
import "../../style/post.css"; // Standard typography

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const readmes = await getCollection("projectReadmes");
const readme = readmes.find((item) => item.data.project === entry.id);
const ReadmeContent = readme ? (await render(readme)).Content : null;
const githubMeta = githubProjects.projects.find((item) => item.project === entry.id);
const projectState = getProjectState(entry, githubProjects.projects);
const unavailable = githubMeta?.syncStatus === "unavailable";
const stale = githubMeta?.syncStatus === "stale";

// Only ship the KaTeX stylesheet when the brief or synced README contains math.
const hasMath =
    (entry.body === undefined ? true : /\$/.test(entry.body)) ||
    (readme ? (readme.body === undefined ? true : /\$/.test(readme.body)) : false);

const ogImage =
    typeof entry.data.image === "string"
        ? entry.data.image
        : entry.data.image?.url;
const ogImageAlt =
    typeof entry.data.image === "object" ? entry.data.image.alt : undefined;

const repoUrl = unavailable ? "" : githubMeta?.url || (entry.data.githubRepo ? `https://github.com/${entry.data.githubRepo}` : "");
const repoLabel = entry.data.githubRepo || githubMeta?.repo;
const pushedDate = githubMeta?.pushedAt ? new Date(githubMeta.pushedAt) : null;
// Status and "fork" are lowercase enums; capitalise them to match the authored type.
const metaLabels = uniqueLabels([
    entry.data.type,
    projectState.status,
    projectState.fork ? "fork" : "",
    String(entry.data.pubDate.getFullYear()),
]).map((label) => label.charAt(0).toUpperCase() + label.slice(1));

// Some projects use their repository as their website; link that address once, as Source.
const normalizeUrl = (url: string) => url.toLowerCase().replace(/\/+$/, "");
const websiteUrl = entry.data.url && normalizeUrl(entry.data.url) !== normalizeUrl(repoUrl) ? entry.data.url : "";
const websiteExternal = websiteUrl !== "" && isExternalUrl(websiteUrl, Astro.site?.origin);

// Most synced READMEs open with the project's name, which the page title already shows.
const readmeHeading = readme?.body?.trimStart().match(/^(?:#[ \t]+([^\n]+)|<h1\b[^>]*>([\s\S]*?)<\/h1>)/i);
const readmeRepeatsTitle = readmeHeading
    ? (readmeHeading[1] ?? readmeHeading[2]).replace(/<[^>]*>/g, "").trim().toLowerCase() === entry.data.title.toLowerCase()
    : false;
---

<MinimalLayout
    title={entry.data.title}
    section="Projects"
    description={entry.data.description}
    image={ogImage}
    imageAlt={ogImageAlt}
    ogType="article"
    math={hasMath}
    datePublished={entry.data.pubDate}
>
    <article
        class="p-6 md:p-12 max-w-4xl mx-auto"
        transition:animate="fade"
    >
        <!-- Project Header -->
        <header class="mb-10">
            <h1 class="text-3xl md:text-4xl font-bold font-heading mb-4">
                {entry.data.title}
            </h1>

            <p
                class="text-xl text-[var(--text-muted)] leading-relaxed max-w-2xl"
            >
                {entry.data.description}
            </p>

            {
                (unavailable || stale) && (
                    <p class="mt-4 max-w-2xl text-sm text-[var(--text-muted)]">
                        {unavailable
                            ? `The repository ${repoLabel} is not currently public at this address. The metadata and README below are the last saved public snapshot.`
                            : "GitHub could not be refreshed. The metadata below are from the last successful sync."}
                    </p>
                )
            }

            {/* A no-break space before each "·" keeps the dot off the start of a wrapped line. */}
            <p class="mt-6 font-mono text-xs text-[var(--text-faint)]">
                {metaLabels.map((label, index) => <>{index > 0 && "\u00a0· "}<span class="whitespace-nowrap">{label}</span></>)}{pushedDate && <>{"\u00a0· "}<span class="whitespace-nowrap">Updated <time datetime={pushedDate.toISOString()}>{formatDateLong(pushedDate)}</time></span></>}
            </p>
            {
                entry.data.stack.length > 0 && (
                    <p class="mt-2 font-mono text-xs text-[var(--text-faint)]">
                        {entry.data.stack.join(", ")}
                    </p>
                )
            }

            {
                (websiteUrl || repoUrl) && (
                    <p class="mt-4 font-mono text-sm text-[var(--text-muted)]">
                        {websiteUrl && (
                            <a
                                href={websiteUrl}
                                target={websiteExternal ? "_blank" : undefined}
                                rel={websiteExternal ? "noopener noreferrer" : undefined}
                                class="inline-block py-1.5 -my-1.5 underline decoration-1 underline-offset-4 hover:text-[var(--text-main)] transition-colors"
                            >
                                Website{websiteExternal && <><span aria-hidden="true"> ↗</span><span class="sr-only"> (external)</span></>}
                            </a>
                        )}
                        {websiteUrl && repoUrl && " · "}
                        {repoUrl && (
                            <a
                                href={repoUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-block py-1.5 -my-1.5 underline decoration-1 underline-offset-4 hover:text-[var(--text-main)] transition-colors"
                            >
                                Source<span aria-hidden="true"> ↗</span><span class="sr-only"> (external)</span>
                            </a>
                        )}
                    </p>
                )
            }
        </header>

        <!-- Human-edited project brief -->
        <section class="mb-12">
            <div class="post-content project-brief-content">
                <Content />
            </div>
        </section>

        {
            ReadmeContent && (
                <section class="mt-24">
                    <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--text-muted)] mb-3">
                        README
                        {repoUrl && " · "}
                        {repoUrl && (
                            <a
                                href={repoUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-block py-2 -my-2 underline decoration-1 underline-offset-4 hover:text-[var(--text-main)] transition-colors"
                            >
                                on GitHub<span aria-hidden="true"> ↗</span><span class="sr-only"> (external)</span>
                            </a>
                        )}
                    </h2>
                    <div class:list={["post-content github-readme-content", { "readme-same-title": readmeRepeatsTitle }]}>
                        <ReadmeContent />
                    </div>
                </section>
            )
        }
    </article>
</MinimalLayout>

<style>
    .project-brief-content :global(h1:first-child),
    .project-brief-content :global(h2:first-child),
    .github-readme-content :global(h1:first-child),
    .github-readme-content :global(h2:first-child) {
        margin-top: 0 !important;
    }

    /* The README is never edited here; its opening heading is hidden when it repeats the page title. */
    .github-readme-content.readme-same-title > :global(h1:first-child) {
        display: none;
    }
    .github-readme-content.readme-same-title > :global(h1:first-child + *) {
        margin-top: 0 !important;
    }
</style>
