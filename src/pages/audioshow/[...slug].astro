---
import { getCollection, render } from "astro:content";
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import "../../style/post.css";

export async function getStaticPaths() {
    const audioshowEntries = await getCollection("audioshow");
    return audioshowEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

import { formatDateLong } from "../../utils/formatDate";
import { batchEpisodeRange } from "../../utils/parseAudioshow";

const { entry } = Astro.props;
const { Content } = await render(entry);

const episodeLabel = batchEpisodeRange(entry.body ?? "", entry.id, String(entry.data.episode));

const ogImage =
    (typeof entry.data.image === "string"
        ? entry.data.image
        : entry.data.image?.url) ?? entry.data.coverImage;
---

<MinimalLayout
    title={`EP ${episodeLabel}: ${entry.data.title}`}
    section="AudioShow"
    description={entry.data.description ??
        `AudioShow Episode ${episodeLabel} — ${entry.data.title}`}
    image={ogImage}
    imageAlt={`AudioShow EP ${episodeLabel} cover art`}
    ogType="article"
    datePublished={entry.data.pubDate}
>
    <div class="p-6 md:p-12 md:mb-20 max-w-4xl mx-auto" transition:animate="fade">
        <!-- Back link on phones only; from md up the sidebar marks and links the section. -->
        <a
            href="/audioshow/"
            class="md:hidden inline-block py-3 -mt-3 mb-6 font-mono text-sm text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
        >
            <span aria-hidden="true">← </span>AudioShow
        </a>

        <article>
            <!-- Header -->
            <header class="mb-10 text-center">
                <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">
                    EP {episodeLabel}
                </h1>
                <time
                    datetime={entry.data.pubDate.toISOString().slice(0, 10)}
                    class="block font-mono text-xs text-[var(--text-faint)]"
                >
                    {formatDateLong(entry.data.pubDate)}
                </time>

                {
                    entry.data.description && (
                        <p class="mt-4 text-lg text-[var(--text-muted)] leading-relaxed max-w-2xl mx-auto">
                            {entry.data.description}
                        </p>
                    )
                }
            </header>

            <!-- Content -->
            <div class="post-content text-center">
                <Content />
            </div>
        </article>
    </div>
</MinimalLayout>

<script>
    import "../../scripts/audio/batch";
</script>

<style>
    /* Center images in AudioShow posts. No frame; the fill marks a cover's slot while it loads. */
    .post-content :global(img) {
        background-color: var(--border-subtle);
        margin-left: auto;
        margin-right: auto;
        margin-top: 1rem; /* Close to EP header above */
        margin-bottom: 4rem; /* More space before next EP */
    }

    /* Reserve a square while covers load; loaded art keeps its own ratio. Covers
       carry a width attribute; wide lead images (EP 0) do not, so they keep theirs. */
    .post-content :global(img[width]) {
        aspect-ratio: auto 1 / 1;
    }

    /* AudioShow metadata lists: mono font, no indent, no bullets */
    .post-content :global(ul) {
        list-style: none;
        padding-left: 0;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .post-content :global(li) {
        padding-left: 0;
        margin-bottom: 0.25rem;
    }
</style>
