---
import MinimalLayout from "../../../layouts/MinimalLayout.astro";
import { audioshowCrates, type AudioShowCrate } from "../../../data/audioshowCrates";
import { audioImage, audioImageSrcset, imageReferrerPolicy } from "../../../utils/audioImages.mjs";

export function getStaticPaths() {
    return audioshowCrates.map((crate) => ({
        params: { slug: crate.slug },
        props: { crate },
    }));
}

const { crate } = Astro.props as { crate: AudioShowCrate };
const groupedTracks = crate.sections.map((section) => ({
    ...section,
    tracks: crate.tracks.filter((track) => track.section === section.title),
}));
const cratePlaylist = crate.tracks.map((track) => ({
    type: "local",
    url: track.audioPreviewUrl,
    title: track.title,
    artist: track.artists,
    artwork: audioImage(track.cover, 320) || track.cover,
}));
---

<MinimalLayout
    title={crate.title}
    section="AudioShow"
    description={crate.premise}
    image={crate.socialImage ?? crate.cover}
    imageAlt={`${crate.title} cover`}
    ogType="music.playlist"
>
    <div class="p-6 md:p-12 md:mb-20" transition:animate="fade">
        <div class="flex flex-wrap gap-x-3 gap-y-3 mb-10 font-mono text-sm">
            <a
                href="/audioshow/"
                class="py-1.5 -my-1.5 text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
            >
                <span aria-hidden="true">[ </span>Recent<span aria-hidden="true"> ]</span>
            </a>
            <a
                href="/audioshow/crates/"
                class="py-1.5 -my-1.5 text-[var(--text-main)] underline decoration-1 underline-offset-4"
                aria-current="true"
            >
                <span aria-hidden="true">[ </span>Crates<span aria-hidden="true"> ]</span>
            </a>
            <a
                href="/audioshow/archive/"
                class="py-1.5 -my-1.5 text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
            >
                <span aria-hidden="true">[ </span>Archive<span aria-hidden="true"> ]</span>
            </a>
        </div>

        <article data-audio-crate>
            <script is:inline type="application/json" id="crate-playlist" set:html={JSON.stringify(cratePlaylist).replace(/</g, "\\u003c")} />
            <header class="mb-10 grid gap-6 md:grid-cols-[220px_1fr] md:gap-8">
                <div class="aspect-square overflow-hidden bg-neutral-100 dark:bg-neutral-900">
                    <img
                        src={audioImage(crate.cover, 320) || crate.cover}
                        srcset={audioImageSrcset(crate.cover, [96, 320])}
                        sizes="(min-width: 768px) 220px, 100vw"
                        alt={`${crate.title} cover`}
                        width="320"
                        height="320"
                        class="h-full w-full object-cover"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        referrerpolicy={imageReferrerPolicy(crate.cover)}
                    />
                </div>

                <div class="min-w-0 self-end">
                    <h1 class="mb-2 text-3xl md:text-4xl font-bold font-heading leading-tight">
                        {crate.title}
                    </h1>

                    <p class="mb-5 font-mono text-xs text-[var(--text-faint)]">
                        <span class="whitespace-nowrap">Crate {crate.number}</span> · <span class="whitespace-nowrap">{crate.trackCount} {crate.trackCount === 1 ? "track" : "tracks"}</span> · <span class="whitespace-nowrap">{crate.duration}</span> · <span class="whitespace-nowrap">{crate.updated}</span>
                    </p>

                    <p class="mb-5 max-w-3xl text-base md:text-lg text-[var(--text-muted)] leading-relaxed">
                        {crate.premise}
                    </p>

                    <p class="mb-5 max-w-3xl text-sm leading-relaxed">
                        {crate.curatorNote}
                    </p>

                    <a
                        href={crate.spotifyUrl}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-block py-1.5 -my-1.5 font-mono text-sm text-[var(--text-muted)] underline decoration-1 underline-offset-4 hover:text-[var(--text-main)] transition-colors"
                    >
                        Open full crate on Spotify<span aria-hidden="true"> ↗</span><span class="sr-only"> (external)</span>
                    </a>
                </div>
            </header>

            <div class="space-y-12">
                {groupedTracks.map((section) => (
                    <section>
                        <div class="mb-3">
                            <h2 class="text-xl font-bold font-heading">
                                {section.title}
                            </h2>
                            <p class="mt-2 max-w-3xl text-sm text-[var(--text-muted)] leading-relaxed">
                                {section.note}
                            </p>
                        </div>

                        <div>
                            {section.tracks.map((track) => (
                                <div
                                    class="track-row group grid cursor-pointer grid-cols-[48px_minmax(0,1fr)_32px] gap-x-4 gap-y-1 py-2.5 px-2 -mx-2 transition-colors md:grid-cols-[56px_56px_minmax(0,1fr)_220px_40px] md:items-center md:gap-4"
                                    data-crate-index={crate.tracks.indexOf(track)}
                                    tabindex="0"
                                    role="button"
                                    aria-label={`Play preview: ${track.title}`}
                                >
                                    <div class="row-span-2 h-12 w-12 overflow-hidden bg-[var(--border-subtle)] md:row-span-1 md:h-14 md:w-14">
                                        <img
                                            src={audioImage(track.cover, 96) || track.cover}
                                            srcset={audioImageSrcset(track.cover, [96, 192])}
                                            sizes="56px"
                                            alt={`${track.album} cover`}
                                            width="56"
                                            height="56"
                                            class="h-full w-full object-cover"
                                            loading="lazy"
                                            decoding="async"
                                            referrerpolicy={imageReferrerPolicy(track.cover)}
                                        />
                                    </div>

                                    <div class="hidden font-mono text-sm text-[var(--text-muted)] md:block">
                                        {track.number.toString().padStart(2, "0")}
                                    </div>

                                    <div class="min-w-0">
                                        <h3 class="truncate font-bold leading-tight">
                                            <span class="font-mono text-xs font-normal text-[var(--text-muted)] md:hidden">{track.number.toString().padStart(2, "0")}</span> {track.title}
                                        </h3>
                                        <div class="truncate text-xs text-[var(--text-muted)]">
                                            {track.album} ({track.year})
                                        </div>
                                    </div>

                                    <div class="col-start-2 truncate text-sm text-[var(--text-muted)] md:col-start-auto">
                                        {track.artists}
                                    </div>

                                    <span
                                        class="col-start-3 row-span-2 row-start-1 self-center text-center text-sm text-[var(--text-muted)] transition-colors group-hover:text-[var(--text-main)] md:col-start-auto md:row-span-1 md:row-start-auto"
                                        aria-hidden="true"
                                    >
                                        ▶
                                    </span>
                                </div>
                            ))}
                        </div>
                    </section>
                ))}
            </div>
        </article>
    </div>
</MinimalLayout>

<script>
    import type { AudioTrack } from "../../../scripts/audio/types";

    document.addEventListener("astro:page-load", () => {
        const crate = document.querySelector<HTMLElement>("[data-audio-crate]");
        const data = document.getElementById("crate-playlist");
        if (!crate || !data) return;
        const playlist: AudioTrack[] = JSON.parse(data.textContent || "[]");

        const playRow = (target: EventTarget | null) => {
            if (!(target instanceof Element)) return;
            const row = target.closest<HTMLElement>("[data-crate-index]");
            if (!row) return;
            const index = Number(row.dataset.crateIndex);
            const track = playlist[index];
            if (!track) return;
            window.playTrack?.({
                ...track,
                _plIdx: index,
                _playlist: playlist,
            });
        };

        crate.onclick = (event) => playRow(event.target);
        crate.onkeydown = (event) => {
            if (event.key !== "Enter" && event.key !== " ") return;
            if (!(event.target instanceof Element) || !event.target.closest("[data-crate-index]")) return;
            event.preventDefault();
            playRow(event.target);
        };
    });
</script>

<style>
    .track-row:hover,
    .track-row:focus-visible {
        background: color-mix(in srgb, var(--text-main) 5%, transparent);
    }

    .track-row:focus-visible {
        outline: 2px solid var(--text-main);
        outline-offset: -2px;
    }
</style>
