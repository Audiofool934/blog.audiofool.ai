---
import MinimalLayout from "../../../layouts/MinimalLayout.astro";
import { audioshowCrates, type AudioShowCrate } from "../../../data/audioshowCrates";
import { audioImage, audioImageSrcset, imageReferrerPolicy } from "../../../utils/audioImages.mjs";

export function getStaticPaths() {
    return audioshowCrates.map((crate) => ({
        params: { slug: crate.slug },
        props: { crate },
    }));
}

const { crate } = Astro.props as { crate: AudioShowCrate };
const groupedTracks = crate.sections.map((section) => ({
    ...section,
    tracks: crate.tracks.filter((track) => track.section === section.title),
}));
const cratePlaylist = crate.tracks.map((track) => ({
    type: "local",
    url: track.audioPreviewUrl,
    title: track.title,
    artist: track.artists,
    artwork: audioImage(track.cover, 320) || track.cover,
}));
---

<MinimalLayout
    title={crate.title}
    section="AudioShow"
    description={crate.premise}
    image={crate.socialImage ?? crate.cover}
    imageAlt={`${crate.title} cover`}
    ogType="music.playlist"
>
    <div class="p-6 md:p-12 mb-20" transition:animate="fade">
        <div class="mb-8">
            <h1 class="text-4xl font-bold font-heading mb-2">AudioShow Crates</h1>
            <p class="font-mono text-sm text-[var(--text-muted)] tracking-wider">
                Is there anybody in there?
            </p>
        </div>

        <div class="flex gap-4 mb-10 text-sm font-mono border-b border-[var(--border-main)] pb-4">
            <a
                href="/audioshow/"
                class="text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
            >
                [ Recent ]
            </a>
            <a
                href="/audioshow/crates/"
                class="text-[var(--text-main)] underline decoration-1 underline-offset-4"
            >
                [ Crates ]
            </a>
            <a
                href="/audioshow/archive/"
                class="text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
            >
                [ Archive ]
            </a>
        </div>

        <article data-audio-crate>
            <script is:inline type="application/json" id="crate-playlist" set:html={JSON.stringify(cratePlaylist).replace(/</g, "\\u003c")} />
            <header class="mb-10 grid gap-6 border-b border-[var(--border-main)] pb-8 md:grid-cols-[220px_1fr] md:gap-8">
                <div class="aspect-square overflow-hidden border border-[var(--border-main)] bg-neutral-100 dark:bg-neutral-900">
                    <img
                        src={audioImage(crate.cover, 320) || crate.cover}
                        srcset={audioImageSrcset(crate.cover, [96, 320])}
                        sizes="(min-width: 768px) 220px, 100vw"
                        alt={`${crate.title} cover`}
                        width="320"
                        height="320"
                        class="h-full w-full object-cover"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        referrerpolicy={imageReferrerPolicy(crate.cover)}
                    />
                </div>

                <div class="min-w-0 self-end">
                    <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs uppercase tracking-wider text-[var(--text-muted)]">
                        <span>Crate {crate.number}</span>
                        <span>{crate.trackCount} tracks</span>
                        <span>{crate.duration}</span>
                        <span>{crate.updated}</span>
                    </div>

                    <h2 class="mb-3 text-3xl md:text-5xl font-bold font-heading leading-tight">
                        {crate.title}
                    </h2>

                    <p class="mb-5 max-w-3xl text-base md:text-lg text-[var(--text-muted)] leading-relaxed">
                        {crate.premise}
                    </p>

                    <p class="mb-5 max-w-3xl text-sm leading-relaxed">
                        {crate.curatorNote}
                    </p>

                    <div class="flex flex-wrap gap-3 font-mono text-xs">
                        <a
                            href={crate.spotifyUrl}
                            target="_blank"
                            rel="noreferrer"
                            class="border border-[var(--border-main)] px-3 py-2 text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--text-main)]/5 transition-colors"
                        >
                            Open full crate on Spotify
                        </a>
                        <a
                            href="/audioshow/crates/"
                            class="border border-[var(--border-main)] px-3 py-2 text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--text-main)]/5 transition-colors"
                        >
                            Back to Crates
                        </a>
                    </div>
                </div>
            </header>

            <div class="space-y-8">
                {groupedTracks.map((section) => (
                    <section class="border border-[var(--border-main)]">
                        <div class="border-b border-[var(--border-main)] p-4">
                            <div class="flex flex-wrap items-baseline justify-between gap-3">
                                <h3 class="text-xl font-bold font-heading">
                                    {section.title}
                                </h3>
                                <span class="font-mono text-xs text-[var(--text-muted)]">
                                    {section.tracks.length} tracks
                                </span>
                            </div>
                            <p class="mt-2 max-w-3xl text-sm text-[var(--text-muted)] leading-relaxed">
                                {section.note}
                            </p>
                        </div>

                        <div>
                            {section.tracks.map((track) => (
                                <div
                                    class="track-row group grid cursor-pointer grid-cols-[48px_minmax(0,1fr)_32px] gap-4 border-b border-[var(--border-main)] p-4 transition-colors last:border-b-0 md:grid-cols-[56px_56px_minmax(0,1fr)_220px_40px] md:items-center"
                                    data-crate-index={crate.tracks.indexOf(track)}
                                    tabindex="0"
                                    role="button"
                                    aria-label={`Play preview: ${track.title}`}
                                >
                                    <div class="h-12 w-12 overflow-hidden border border-[var(--border-main)] md:h-14 md:w-14">
                                        <img
                                            src={audioImage(track.cover, 96) || track.cover}
                                            srcset={audioImageSrcset(track.cover, [96, 192])}
                                            sizes="56px"
                                            alt={`${track.album} cover`}
                                            width="56"
                                            height="56"
                                            class="h-full w-full object-cover"
                                            loading="lazy"
                                            decoding="async"
                                            referrerpolicy={imageReferrerPolicy(track.cover)}
                                        />
                                    </div>

                                    <div class="hidden font-mono text-sm text-[var(--text-muted)] md:block">
                                        {track.number.toString().padStart(2, "0")}
                                    </div>

                                    <div class="min-w-0">
                                        <div class="flex items-baseline gap-2 md:hidden">
                                            <span class="font-mono text-xs text-[var(--text-muted)]">
                                                {track.number.toString().padStart(2, "0")}
                                            </span>
                                            <h4 class="truncate font-bold leading-tight">
                                                {track.title}
                                            </h4>
                                        </div>
                                        <h4 class="hidden truncate font-bold leading-tight md:block">
                                            {track.title}
                                        </h4>
                                        <div class="truncate text-xs text-[var(--text-muted)]">
                                            {track.album} ({track.year})
                                        </div>
                                    </div>

                                    <div class="col-start-2 truncate text-sm text-[var(--text-muted)] md:col-start-auto">
                                        {track.artists}
                                    </div>

                                    <span
                                        class="col-start-3 row-span-2 row-start-1 self-center text-center text-sm text-[var(--text-muted)] transition-colors group-hover:text-[var(--text-main)] md:col-start-auto md:row-span-1 md:row-start-auto"
                                        aria-hidden="true"
                                    >
                                        ▶
                                    </span>
                                </div>
                            ))}
                        </div>
                    </section>
                ))}
            </div>
        </article>
    </div>
</MinimalLayout>

<script>
    import type { AudioTrack } from "../../../scripts/audio/types";

    document.addEventListener("astro:page-load", () => {
        const crate = document.querySelector<HTMLElement>("[data-audio-crate]");
        const data = document.getElementById("crate-playlist");
        if (!crate || !data) return;
        const playlist: AudioTrack[] = JSON.parse(data.textContent || "[]");

        const playRow = (target: EventTarget | null) => {
            if (!(target instanceof Element)) return;
            const row = target.closest<HTMLElement>("[data-crate-index]");
            if (!row) return;
            const index = Number(row.dataset.crateIndex);
            const track = playlist[index];
            if (!track) return;
            window.playTrack?.({
                ...track,
                _plIdx: index,
                _playlist: playlist,
            });
        };

        crate.onclick = (event) => playRow(event.target);
        crate.onkeydown = (event) => {
            if (event.key !== "Enter" && event.key !== " ") return;
            if (!(event.target instanceof Element) || !event.target.closest("[data-crate-index]")) return;
            event.preventDefault();
            playRow(event.target);
        };
    });
</script>

<style>
    .track-row:hover,
    .track-row:focus-visible {
        background: color-mix(in srgb, var(--text-main) 5%, transparent);
    }

    .track-row:focus-visible {
        outline: 2px solid var(--text-main);
        outline-offset: -2px;
    }
</style>
