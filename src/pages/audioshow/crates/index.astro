---
import MinimalLayout from "../../../layouts/MinimalLayout.astro";
import { audioshowCrates } from "../../../data/audioshowCrates";
import { audioImage, audioImageSrcset, imageReferrerPolicy } from "../../../utils/audioImages.mjs";

const crateCount = audioshowCrates.length;
---

<MinimalLayout
    title="Crates | AudioShow | Audiofool"
    description="Is there anybody in there?"
>
    <div class="p-6 md:p-12 md:mb-20" transition:animate="fade">
        <div class="mb-10">
            <h1 class="text-4xl font-bold font-heading mb-2">AudioShow Crates</h1>
            <p class="font-mono text-sm text-[var(--text-muted)]">
                Is there anybody in there?
            </p>
        </div>

        <div class="flex flex-wrap gap-x-3 gap-y-3 mb-10 font-mono text-sm">
            <a
                href="/audioshow/"
                class="py-1.5 -my-1.5 text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
            >
                <span aria-hidden="true">[ </span>Recent<span aria-hidden="true"> ]</span>
            </a>
            <span class="text-[var(--text-main)] underline decoration-1 underline-offset-4" aria-current="page">
                <span aria-hidden="true">[ </span>Crates<span aria-hidden="true"> ]</span>
            </span>
            <a
                href="/audioshow/archive/"
                class="py-1.5 -my-1.5 text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
            >
                <span aria-hidden="true">[ </span>Archive<span aria-hidden="true"> ]</span>
            </a>
        </div>

        <section class="space-y-10 md:space-y-12">
            {audioshowCrates.map((crate, index) => (
                <article
                    class="group cursor-pointer"
                    data-crate-card
                    data-crate-url={`/audioshow/crates/${crate.slug}/`}
                >
                    <div class="grid gap-5 md:grid-cols-[160px_1fr] md:gap-6">
                        <div class="aspect-square overflow-hidden bg-neutral-100 dark:bg-neutral-900">
                            <img
                                src={audioImage(crate.cover, 320) || crate.cover}
                                srcset={audioImageSrcset(crate.cover, [96, 320])}
                                sizes="(min-width: 768px) 160px, 100vw"
                                alt={`${crate.title} cover`}
                                width="320"
                                height="320"
                                class="h-full w-full object-cover"
                                loading={index === 0 ? "eager" : "lazy"}
                                fetchpriority={index === 0 ? "high" : "auto"}
                                decoding="async"
                                referrerpolicy={imageReferrerPolicy(crate.cover)}
                            />
                        </div>

                        <div class="min-w-0">
                            <p class="mb-2 font-mono text-xs text-[var(--text-faint)]">
                                <span class="whitespace-nowrap">Crate {crate.number}</span> · <span class="whitespace-nowrap">{crate.trackCount} {crate.trackCount === 1 ? "track" : "tracks"}</span> · <span class="whitespace-nowrap">{crate.duration}</span> · <span class="whitespace-nowrap">{crate.updated}</span>
                            </p>

                            <h2 class="mb-2 text-2xl font-bold font-heading leading-tight">
                                <a
                                    href={`/audioshow/crates/${crate.slug}/`}
                                    class="group-hover:underline focus-visible:underline decoration-1 underline-offset-4"
                                >
                                    {crate.title}
                                </a>
                            </h2>

                            <p class="mb-4 max-w-3xl text-sm md:text-base text-[var(--text-muted)] leading-relaxed">
                                {crate.premise}
                            </p>

                            <p class="mb-4 font-mono text-xs text-[var(--text-faint)]">
                                {crate.tags.join(", ")}
                            </p>

                            <a
                                href={crate.spotifyUrl}
                                target="_blank"
                                rel="noreferrer"
                                class="inline-block py-1.5 -my-1.5 font-mono text-sm text-[var(--text-muted)] underline decoration-1 underline-offset-4 hover:text-[var(--text-main)] transition-colors"
                            >
                                Spotify<span aria-hidden="true"> ↗</span><span class="sr-only"> (external)</span>
                            </a>
                        </div>
                    </div>
                </article>
            ))}
        </section>

        {crateCount === 0 && (
            <div class="py-16 text-center text-[var(--text-muted)]">
                <p>No crates filed yet.</p>
            </div>
        )}
    </div>
</MinimalLayout>

<script>
    import { navigate } from "astro:transitions/client";

    // The title is the crate link; a click elsewhere on the crate opens it too, as a pointer convenience.
    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLElement>("[data-crate-card]").forEach((card) => {
            card.addEventListener("click", (event) => {
                const target = event.target;
                if (target instanceof Element && target.closest("a")) return;
                const url = card.dataset.crateUrl;
                if (url) navigate(url);
            });
        });
    });
</script>
