---
import MinimalLayout from "../../../layouts/MinimalLayout.astro";
import { groupEpisodesByRange } from "../../../utils/parseAudioshow";
import { loadAllEpisodes } from "../../../utils/loadEpisodes";
import { audioImage, audioImageSrcset, imageReferrerPolicy } from "../../../utils/audioImages.mjs";

const allEpisodes = loadAllEpisodes();

// Group episodes by ranges of 50
const groupedEpisodes = groupEpisodesByRange(allEpisodes, 50);

// Sort range keys numerically
const sortedRanges = Object.keys(groupedEpisodes).sort((a, b) => {
    const startA = parseInt(a.split('-')[0], 10);
    const startB = parseInt(b.split('-')[0], 10);
    return startA - startB;
});

// Label each range by the episodes it holds, so a partial range reads "EP 201-225".
const rangeLabel = (range: string) => {
    const episodes = groupedEpisodes[range];
    const first = episodes[0].number;
    const last = episodes[episodes.length - 1].number;
    return first === last ? `EP ${first}` : `EP ${first}-${last}`;
};

// Placeholder image
const placeholderImage = "/images/placeholder-album.svg";
---

<MinimalLayout
    title="Archive | AudioShow | Audiofool"
    description="The long shelf of what still answers."
>
    <div class="p-6 md:p-12 md:mb-20" transition:animate="fade">
        <!-- Header -->
        <div class="mb-10">
            <h1 class="text-4xl font-bold font-heading mb-2">AudioShow Archive</h1>
            <p class="font-mono text-sm text-[var(--text-muted)]">
                The long shelf of what still answers.
            </p>
        </div>

        <!-- Navigation -->
        <div class="flex flex-wrap gap-x-3 gap-y-3 mb-10 font-mono text-sm">
            <a 
                href="/audioshow/"
                class="py-1.5 -my-1.5 text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
            >
                <span aria-hidden="true">[ </span>Recent<span aria-hidden="true"> ]</span>
            </a>
            <a
                href="/audioshow/crates/"
                class="py-1.5 -my-1.5 text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
            >
                <span aria-hidden="true">[ </span>Crates<span aria-hidden="true"> ]</span>
            </a>
            <span class="text-[var(--text-main)] underline decoration-1 underline-offset-4" aria-current="page">
                <span aria-hidden="true">[ </span>Archive<span aria-hidden="true"> ]</span>
            </span>
        </div>

        <!-- Episode Ranges -->
        <div class="space-y-2" data-audioshow-archive>
            {sortedRanges.map((range) => (
                <section data-range={range}>
                    <details class="group open:pb-8">
                        <summary class="cursor-pointer py-3 flex items-center justify-between">
                            <h2 class="text-lg font-bold font-heading">
                                {rangeLabel(range)}
                            </h2>
                            <div class="flex items-center gap-4">
                                <!-- Toggle All Lyrics Button -->
                                <button 
                                    class="text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors py-2 -my-2"
                                    data-toggle-all={range}
                                    type="button"
                                    aria-expanded="false"
                                >
                                    Show lyrics
                                </button>
                                <span class="font-mono text-xs text-[var(--text-muted)] group-open:rotate-90 transition-transform">
                                    →
                                </span>
                            </div>
                        </summary>

                        <div class="border-t border-[var(--border-subtle)]" data-episodes={range}>
                            {groupedEpisodes[range].map((ep) => {
                                const cover = ep.imageUrl || placeholderImage;
                                const artwork = audioImage(cover, 320) || placeholderImage;
                                return (
                                <div class="episode-item" data-ep={ep.number}>
                                    <!-- Main Row -->
                                    <div 
                                        class="episode-row"
                                        data-ep-row={ep.number}
                                    >
                                        <!-- Thumbnail -->
                                        <div class="episode-thumbnail">
                                            <img
                                                src={audioImage(cover, 96) || placeholderImage}
                                                srcset={audioImageSrcset(cover, [96, 192])}
                                                sizes="48px"
                                                alt={ep.songTitle}
                                                width="48"
                                                height="48"
                                                class="w-full h-full object-cover"
                                                loading="lazy"
                                                decoding="async"
                                                referrerpolicy={imageReferrerPolicy(cover)}
                                                onerror={`this.src='${placeholderImage}'`}
                                            />
                                        </div>

                                        <!-- Episode Number -->
                                        <div class="episode-number">
                                            #{ep.number}
                                        </div>

                                        <!-- Song Info: Title + Album -->
                                        <div class="flex-1 min-w-0">
                                            <div class="font-bold truncate">
                                                {ep.songTitle}
                                            </div>
                                            <div class="episode-album">
                                                {ep.album} ({ep.year})
                                            </div>
                                        </div>

                                        <!-- Artist on right -->
                                        <div class="episode-artist">
                                            {ep.artist}
                                        </div>

                                        <!-- Play Button -->
                                        {(ep.playbackUrl || ep.audioPreviewUrl) ? (
                                            <button
                                                class="episode-play"
                                                aria-label={`Play ${ep.songTitle} by ${ep.artist}`}
                                                data-play-track={JSON.stringify({
                                                    type: (ep.audioPreviewUrl || ep.playbackUrl)?.includes('music.apple.com') ? 'apple' : 'local',
                                                    url: ep.audioPreviewUrl || ep.playbackUrl,
                                                    title: ep.songTitle,
                                                    artist: ep.artist,
                                                    artwork
                                                })}
                                            >
                                                <span aria-hidden="true">▶</span>
                                            </button>
                                        ) : (
                                            <div class="w-8" aria-hidden="true"></div>
                                        )}

                                        <!-- Expand Toggle -->
                                        <button
                                            type="button"
                                            class="lyrics-arrow"
                                            data-ep-toggle={ep.number}
                                            aria-label={`Toggle lyrics for ${ep.songTitle}`}
                                            aria-expanded="false"
                                        >
                                            <span aria-hidden="true">↓</span>
                                        </button>
                                    </div>

                                    <!-- Lyrics (Hidden by default) -->
                                    <div class="lyrics-content hidden pb-4">
                                        <div class="lyrics-body">
                                            <p class="episode-lyric">
                                                {`"${ep.lyricExcerpt}"`}
                                            </p>
                                            {ep.projectLinks.length > 0 && (
                                                <p class="font-mono text-sm text-[var(--text-muted)]">
                                                    {ep.projectLinks.map((link, index) => (
                                                        <>
                                                            {index > 0 && " · "}
                                                            <a
                                                                href={link.url}
                                                                target="_blank"
                                                                rel="noreferrer"
                                                                class="inline-block py-1.5 -my-1.5 underline decoration-1 underline-offset-4 hover:text-[var(--text-main)] transition-colors"
                                                            >
                                                                {link.label}<span aria-hidden="true"> ↗</span><span class="sr-only"> (external)</span>
                                                            </a>
                                                        </>
                                                    ))}
                                                </p>
                                            )}
                                        </div>
                                    </div>
                                </div>
                                );
                            })}
                        </div>
                    </details>
                </section>
            ))}
        </div>

        <!-- Empty State -->
        {allEpisodes.length === 0 && (
            <div class="py-16 text-center text-[var(--text-muted)]">
                <p>No episodes found. The show hasn't started yet.</p>
            </div>
        )}
    </div>
</MinimalLayout>

<script>
    function setEpisodeExpanded(episode: HTMLElement, expanded: boolean) {
        const lyrics = episode.querySelector<HTMLElement>('.lyrics-content');
        const toggle = episode.querySelector<HTMLButtonElement>('[data-ep-toggle]');
        lyrics?.classList.toggle('hidden', !expanded);
        toggle?.setAttribute('aria-expanded', String(expanded));
    }

    // The range button reads "Hide lyrics" only while every row in its range is open.
    function syncRangeToggle(section: Element | null) {
        const allToggle = section?.querySelector<HTMLButtonElement>('[data-toggle-all]');
        if (!section || !allToggle) return;
        const toggles = Array.from(section.querySelectorAll('[data-ep-toggle]'));
        const allOpen = toggles.length > 0 && toggles.every((toggle) => toggle.getAttribute('aria-expanded') === 'true');
        allToggle.textContent = allOpen ? 'Hide lyrics' : 'Show lyrics';
        allToggle.setAttribute('aria-expanded', String(allOpen));
    }

    document.addEventListener("astro:page-load", () => {
        const archive = document.querySelector<HTMLElement>('[data-audioshow-archive]');
        if (!archive) return;

        // One listener serves every row and is replaced if this DOM is initialized again.
        archive.onclick = (event) => {
            if (!(event.target instanceof Element)) return;
            const allToggle = event.target.closest<HTMLButtonElement>('[data-toggle-all]');
            if (allToggle) {
                event.preventDefault();
                const section = allToggle.closest('section');
                const expand = allToggle.getAttribute('aria-expanded') !== 'true';
                // Showing lyrics also opens a collapsed range, so the reader sees what the label says.
                if (expand) allToggle.closest('details')?.setAttribute('open', '');
                section?.querySelectorAll<HTMLElement>('.episode-item').forEach((episode) => setEpisodeExpanded(episode, expand));
                syncRangeToggle(section);
                return;
            }

            const play = event.target.closest<HTMLButtonElement>('[data-play-track]');
            if (play?.dataset.playTrack) {
                window.playTrack?.(JSON.parse(play.dataset.playTrack));
                return;
            }

            const row = event.target.closest<HTMLElement>('[data-ep-row]');
            const episode = row?.closest<HTMLElement>('.episode-item');
            if (episode) {
                const expand = !!episode.querySelector('.lyrics-content')?.classList.contains('hidden');
                setEpisodeExpanded(episode, expand);
                syncRangeToggle(episode.closest('section'));
            }
        };
    });
</script>

<style>
    /* A faint line closes each episode, so a song and its open lyrics read as one unit. */
    .episode-item { @apply border-b border-[var(--border-subtle)] last:border-b-0; }
    .episode-row { @apply flex items-center gap-4 py-2.5 px-2 -mx-2 transition-colors cursor-pointer; }
    .episode-row:hover { background-color: color-mix(in srgb, var(--text-main) 5%, transparent); }
    .episode-thumbnail { @apply w-12 h-12 flex-shrink-0 bg-[var(--border-subtle)] overflow-hidden; }
    .episode-number { @apply w-12 font-mono text-sm text-[var(--text-faint)] text-right; }
    .episode-album { @apply text-xs text-[var(--text-muted)] truncate; }
    .episode-artist { @apply hidden md:block text-sm text-[var(--text-muted)] truncate max-w-[200px]; }
    .episode-play { @apply w-8 text-center opacity-50 hover:opacity-100 transition-opacity; }
    /* A rule ties the lyrics to their song. The text starts under the number on phones, to keep
       a usable measure, and under the title from md up (48px thumbnail + 16px gap + 48px number
       + 16px gap = 128px); the rule sits 17px before it (1px rule + 16px padding). */
    .lyrics-body { @apply ml-12 md:ml-[111px] pl-4 border-l border-[var(--border-main)] space-y-3; }
    .episode-lyric { @apply text-sm italic text-[var(--text-muted)] whitespace-pre-line; }
    .lyrics-arrow {
        @apply w-6 text-center text-[var(--text-muted)];
        transition: transform 0.2s ease;
    }
    .lyrics-arrow[aria-expanded="true"] { transform: rotate(180deg); }
</style>
