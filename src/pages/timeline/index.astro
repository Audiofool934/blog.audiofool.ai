---
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { formatDateCompact } from "../../utils/formatDate";
import { isExternalUrl } from "../../utils/projectState";
import { getTimelineItems } from "../../utils/timelineItems";
import type { TimelineItem } from "../../utils/timelineItems";

const sortedPosts = await getTimelineItems();

// Items arrive newest first, so each year's rows are already contiguous.
const years: { year: number; posts: TimelineItem[] }[] = [];
for (const post of sortedPosts) {
    const year = post.date.getUTCFullYear();
    const group = years.at(-1);
    if (group?.year === year) group.posts.push(post);
    else years.push({ year, posts: [post] });
}

// Pinned projects link to their own sites; mark those rows so they don't pass for internal pages.
const siteOrigin = Astro.site?.origin;

const typeLabels: Record<string, string> = {
    note: "Notes",
    post: "Posts",
    music: "Music",
    photo: "Photos",
    project: "Projects",
    site: "Site",
};

const filterOrder = ["note", "post", "music", "photo", "project", "site"];
const lanes = new Set(sortedPosts.map((post) => post.lane));
const filters = filterOrder
    .filter((type) => lanes.has(type))
    .map((type) => ({ type, label: typeLabels[type] }));
---

<MinimalLayout
    title="Timeline | Audiofool"
    description="A chronological record of notes, posts, music, photos, and site changes."
>
    <div class="p-6 md:p-12" transition:animate="fade">
        <header class="mb-10">
            <h1 class="text-4xl font-bold font-heading">Timeline</h1>
        </header>

        <div class="flex flex-wrap gap-x-3 gap-y-3 mb-10 font-mono text-sm">
            <button
                type="button"
                data-type="all"
                aria-pressed="true"
                class="timeline-filter active whitespace-nowrap py-1.5 -my-1.5 transition-colors"
            >
                <span aria-hidden="true">[ </span>All<span aria-hidden="true"> ]</span>
            </button>
            {
                filters.map(({ type, label }) => (
                    <button
                        type="button"
                        data-type={type}
                        aria-pressed="false"
                        class="timeline-filter whitespace-nowrap py-1.5 -my-1.5 transition-colors"
                    >
                        <span aria-hidden="true">[ </span>{label}<span aria-hidden="true"> ]</span>
                    </button>
                ))
            }
        </div>

        <!-- The line and dots give the stacked entries a spine to read down. -->
        <div class="spine max-w-2xl">
            {
                years.map(({ year, posts }) => (
                    <section class="timeline-year pt-12 first:pt-0">
                        <h2 class="mb-4 font-mono text-sm font-semibold text-[var(--text-main)]">
                            {year}
                        </h2>

                        {posts.map((post) => {
                            const type = post.lane;
                            const external = isExternalUrl(post.href, siteOrigin);
                            return (
                                <a
                                    href={post.href}
                                    class="timeline-entry group relative block mb-8"
                                    data-type={type}
                                >
                                    <span aria-hidden="true" class="spine-dot" />
                                    <p class="font-mono text-xs uppercase tracking-wider text-[var(--text-faint)]">
                                        <time datetime={post.date.toISOString()}>{formatDateCompact(post.date)}</time> · {type}
                                    </p>
                                    <h3 lang={post.lang} class="mt-2 font-sans text-base font-semibold text-[var(--text-main)] group-hover:underline decoration-1 underline-offset-4">
                                        {post.title}
                                        {external && <span aria-hidden="true"> ↗</span>}
                                        {external && <span class="sr-only"> (external)</span>}
                                    </h3>
                                    {post.description && (
                                        <p class="mt-1 font-sans text-sm leading-relaxed text-[var(--text-muted)]">
                                            {post.description}
                                        </p>
                                    )}
                                </a>
                            );
                        })}
                    </section>
                ))
            }

            <div
                id="timeline-empty"
                class="hidden py-12 text-[var(--text-muted)] font-mono text-sm"
            >
                No entries in this lane yet.
            </div>

            {
                sortedPosts.length === 0 && (
                    <div class="py-12 text-[var(--text-muted)]">
                        No timeline entries yet.
                    </div>
                )
            }
        </div>
    </div>
</MinimalLayout>

<style>
    .timeline-filter {
        color: var(--text-muted);
    }
    .timeline-filter:hover {
        color: var(--text-main);
    }
    .timeline-filter.active {
        color: var(--text-main);
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-thickness: 1px;
    }
</style>

<script>
    (function () {
        let cleanupFn: (() => void) | null = null;

        document.addEventListener("astro:page-load", () => {
            if (cleanupFn) {
                cleanupFn();
                cleanupFn = null;
            }

            const filters = document.querySelectorAll<HTMLElement>(".timeline-filter");
            const entries = document.querySelectorAll<HTMLElement>(".timeline-entry");
            const years = document.querySelectorAll<HTMLElement>(".timeline-year");
            const empty = document.getElementById("timeline-empty");
            if (!filters.length) return;

            function applyFilter(filter: string) {
                filters.forEach((item) => {
                    item.classList.remove("active");
                    item.setAttribute("aria-pressed", "false");
                });
                var btn = document.querySelector(
                    '.timeline-filter[data-type="' + filter + '"]',
                );
                if (btn) {
                    btn.classList.add("active");
                    btn.setAttribute("aria-pressed", "true");
                }

                var visible = 0;
                entries.forEach((entry) => {
                    var show = filter === "all" || entry.dataset.type === filter;
                    entry.style.display = show ? "" : "none";
                    if (show) visible += 1;
                });

                // Hide a year heading once every entry under it is filtered out.
                years.forEach((year) => {
                    var hasVisible = Array.from(
                        year.querySelectorAll<HTMLElement>(".timeline-entry"),
                    ).some((entry) => entry.style.display !== "none");
                    year.style.display = hasVisible ? "" : "none";
                });

                if (empty) empty.classList.toggle("hidden", visible > 0);
            }

            function onClick(e: Event) {
                if (!(e.currentTarget instanceof HTMLElement)) return;
                applyFilter(e.currentTarget.dataset.type || "all");
            }

            filters.forEach((filter) => {
                filter.addEventListener("click", onClick);
            });

            var urlType = new URLSearchParams(window.location.search).get("type");
            if (urlType) applyFilter(urlType.toLowerCase());

            cleanupFn = function () {
                filters.forEach((filter) =>
                    filter.removeEventListener("click", onClick),
                );
            };
        });
    })();
</script>
