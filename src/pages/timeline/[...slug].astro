---
import LegacyRedirect from "../../components/site/LegacyRedirect.astro";
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { getTimelineLogs } from "../../utils/timelineItems";
import "../../style/post.css";

export async function getStaticPaths() {
    const posts = await getCollection("log");
    // Newest first, so a lower index is the newer neighbor.
    const sequence = await getTimelineLogs();
    return posts.map((entry) => {
        const index = sequence.findIndex((post) => post.id === entry.id);
        return {
            params: { slug: entry.id },
            props: {
                entry,
                newer: index > 0 ? sequence[index - 1] : undefined,
                older: index >= 0 ? sequence[index + 1] : undefined,
            },
        };
    });
}

import { formatDateLong } from "../../utils/formatDate";

const { entry, newer, older } = Astro.props;
const redirectTo = entry.data.redirectTo;
const redirectHref = redirectTo ? new URL(redirectTo, Astro.site).href : "";
const rendered = redirectTo ? null : await render(entry);
const Content = rendered?.Content;

// Only ship the KaTeX stylesheet when the post actually contains math.
const hasMath = !redirectTo && (entry.body === undefined ? true : /\$/.test(entry.body));

// A 1200px JPEG of the post's own image becomes its social card.
const shareImage =
    !redirectTo && entry.data.image
        ? await getImage({
              src: entry.data.image,
              width: Math.min(1200, entry.data.image.width),
              format: "jpg",
              quality: 82,
          })
        : null;
---

{
    redirectTo ? (
        <html lang="en">
            <head>
                <meta charset="utf-8" />
                <meta name="robots" content="noindex, follow" />
                <LegacyRedirect target={redirectTo} />
                <link rel="canonical" href={redirectHref} />
                <title>{entry.data.title} | Audiofool</title>
            </head>
            <body>
                <p>
                    This timeline entry has moved to{" "}
                    <a href={redirectTo}>{redirectTo}</a>.
                </p>
            </body>
        </html>
    ) : (
        <MinimalLayout
            title={entry.data.title}
            section="Timeline"
            description={entry.data.description}
            image={shareImage?.src}
            imageAlt={entry.data.imageAlt}
            imageWidth={shareImage?.attributes.width}
            imageHeight={shareImage?.attributes.height}
            ogType="article"
            math={hasMath}
            datePublished={entry.data.pubDate}
        >
            {/* Back link on phones only; from md up the sticky sidebar already marks and links the section. */}
            <div class="md:hidden px-6">
                <div class="max-w-[38rem] mx-auto pt-3 font-mono text-sm text-[var(--text-muted)]">
                    <a
                        href="/timeline/"
                        class="inline-block py-3 hover:text-[var(--text-main)] transition-colors"
                        ><span aria-hidden="true">← </span>Timeline</a
                    >
                </div>
            </div>

            <div class="p-6 md:p-12 flex justify-center" transition:animate="fade">
                <article class="max-w-[38rem] w-full">
                    <!-- Timeline Header -->
                    <header class="mb-10">
                        <h1 class="text-3xl md:text-4xl font-bold font-heading mb-4">
                            {entry.data.title}
                        </h1>
                        <time
                            datetime={entry.data.pubDate.toISOString().slice(0, 10)}
                            class="block font-mono text-xs text-[var(--text-faint)]"
                        >
                            {formatDateLong(entry.data.pubDate)}
                        </time>
                    </header>

                    <!-- Content -->
                    <div class="post-content">
                        {Content && <Content />}
                    </div>

                    {(older || newer) && (
                        <nav
                            aria-label="More from the timeline"
                            class="mt-16 grid gap-6 md:grid-cols-2"
                        >
                            {older && (
                                <a href={`/timeline/${older.id}/`} rel="prev" class="group block">
                                    <span class="block font-mono text-xs text-[var(--text-faint)]">
                                        ← Older
                                    </span>
                                    <span class="mt-1 block text-[var(--text-main)] group-hover:underline decoration-1 underline-offset-4">
                                        {older.data.title}
                                    </span>
                                </a>
                            )}
                            {newer && (
                                <a href={`/timeline/${newer.id}/`} rel="next" class="group block md:col-start-2 md:text-right">
                                    <span class="block font-mono text-xs text-[var(--text-faint)]">
                                        Newer →
                                    </span>
                                    <span class="mt-1 block text-[var(--text-main)] group-hover:underline decoration-1 underline-offset-4">
                                        {newer.data.title}
                                    </span>
                                </a>
                            )}
                        </nav>
                    )}
                </article>
            </div>
        </MinimalLayout>
    )
}
