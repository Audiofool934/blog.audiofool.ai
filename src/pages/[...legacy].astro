---
import LegacyRedirect from "../components/site/LegacyRedirect.astro";
import { legacyRedirects } from "../data/legacyRedirects.mjs";
import { redirectsForFilesystem, isCaseSensitiveFilesystem } from "../utils/legacyRoutes.mjs";

export function getStaticPaths() {
    const redirects = redirectsForFilesystem(legacyRedirects, isCaseSensitiveFilesystem(process.cwd()));
    return redirects.map((redirect) => ({
        params: { legacy: redirect.from },
        props: { target: redirect.to },
    }));
}

const { target } = Astro.props;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex, follow" />
        <LegacyRedirect target={target} />
        <link rel="canonical" href={canonical} />
        <title>Moved | Audiofool</title>
    </head>
    <body>
        <p>This page has moved to <a href={target}>{target}</a>.</p>
    </body>
</html>
