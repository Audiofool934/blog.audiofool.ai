---
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import GalleryToolbar from "../../components/gallery/GalleryToolbar.astro";
import GalleryViewer from "../../components/gallery/GalleryViewer.astro";
import { galleryCategories } from "../../data/galleryCategories";
import { formatDateCompact } from "../../utils/formatDate";

const galleryItems = await getCollection("gallery");

// Sort by date desc
const sortedGallery = galleryItems.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// <Image> emits responsive, width-constrained thumbnails for the masonry grid
// (and carries intrinsic dimensions, so no layout shift). The modal/lightbox
// loads on demand, so pre-generate one optimized, width-capped variant per
// image for it - capped at the source width to avoid upscaling.
async function modalSources(item: (typeof sortedGallery)[0]) {
    const srcs =
        item.data.images && item.data.images.length > 0
            ? item.data.images
            : [item.data.image];
    return Promise.all(
        srcs.map((src) =>
            getImage({
                src,
                width: Math.min(1400, src.width),
                format: "webp",
                quality: 82,
            }).then((r) => r.src),
        ),
    );
}

// Render body content + optimized modal images for each item
const galleryWithBody = await Promise.all(
    sortedGallery.map(async (item) => {
        const { Content } = await render(item);
        const modalImages = await modalSources(item);
        return { item, Content, modalImages };
    }),
);

// Featured count
const featuredCount = sortedGallery.filter(
    (item) => item.data.featured,
).length;

// Build metadata JSON for modal
function buildMeta(item: (typeof sortedGallery)[0], modalImages: string[]) {
    const d = item.data;
    const exifParts = [
        d.focalLength,
        d.aperture,
        d.shutterSpeed,
        d.iso ? `ISO ${d.iso}` : null,
    ]
        .filter(Boolean)
        .join(" · ");
    return JSON.stringify({
        title: d.title,
        image: modalImages[0],
        images: modalImages,
        // ISO for sorting; the label matches the cards.
        date: d.date.toISOString().split("T")[0],
        dateLabel: formatDateCompact(d.date),
        location: d.location || "",
        camera: d.camera || "",
        lens: d.lens || "",
        filmStock: d.filmStock || "",
        exif: exifParts,
        category: d.category,
    }).replace(/</g, "\\u003c");
}
---

<MinimalLayout title="Gallery | Audiofool" description="Obscured by Clouds">
    <div class="p-6 md:p-12" transition:animate="fade">
        <!-- Header -->
        <div class="mb-10">
            <h1 class="text-4xl font-bold font-heading mb-2">Gallery</h1>
            <p class="font-mono text-sm text-[var(--text-muted)]">
                Obscured by Clouds
            </p>
        </div>

        <GalleryToolbar
            total={sortedGallery.length}
            {featuredCount}
            categories={galleryCategories}
        />

        <!-- Masonry Layout -->
        <div class="gallery-masonry">
            {
                galleryWithBody.map(({ item, Content, modalImages }, i) => (
                    <div
                        data-category={item.data.category}
                        data-featured={item.data.featured ? "true" : "false"}
                        data-meta-id={`gallery-meta-${i}`}
                        data-index={i}
                        role="button"
                        tabindex="0"
                        aria-label={`View ${item.data.title}`}
                        class="gallery-item block mb-8 break-inside-avoid cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--text-main)]"
                    >
                        <Image
                            src={item.data.image}
                            alt={item.data.title}
                            width={640}
                            widths={[320, 480, 640, 960]}
                            sizes="(min-width: 1440px) 350px, (min-width: 1024px) calc((100vw - 388px) / 3), (min-width: 768px) calc((100vw - 372px) / 2), (min-width: 640px) calc((100vw - 68px) / 2), calc(100vw - 52px)"
                            class="w-full h-auto block bg-[var(--border-subtle)]"
                            loading={i === 0 ? "eager" : "lazy"}
                            fetchpriority={i === 0 ? "high" : "auto"}
                            decoding="async"
                            quality={76}
                        />
                        <div class="pt-2">
                            <h3 class="font-bold text-sm truncate">
                                {item.data.title}
                            </h3>
                            {/* The date stays whole and keeps its dot; a long location wraps between words. */}
                            <p class="mt-1 font-mono text-xs text-[var(--text-faint)]">
                                <time class="whitespace-nowrap" datetime={item.data.date.toISOString().slice(0, 10)}>{formatDateCompact(item.data.date)}</time>{item.data.location && (
                                    <>{"\u00a0· "}{item.data.location}</>
                                )}
                            </p>
                        </div>
                        {/* Hidden body for modal */}
                        <div class="gallery-body hidden">
                            <Content />
                        </div>
                        <script
                            is:inline
                            type="application/json"
                            id={`gallery-meta-${i}`}
                            set:html={buildMeta(item, modalImages)}
                        ></script>
                    </div>
                ))
            }
        </div>

        {
            sortedGallery.length === 0 && (
                <div class="py-12 text-center text-[var(--text-muted)]">
                    No images found. Clouds are obscuring everything.
                </div>
            )
        }
    </div>

    <GalleryViewer />

    <style>
        .gallery-masonry {
            columns: 1;
            column-gap: 1rem;
        }
        @media (min-width: 640px) {
            .gallery-masonry {
                columns: 2;
            }
        }
        @media (min-width: 1024px) {
            .gallery-masonry {
                columns: 3;
            }
        }

    </style>
</MinimalLayout>
