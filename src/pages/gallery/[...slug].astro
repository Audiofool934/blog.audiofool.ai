---
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import "../../style/post.css";

export async function getStaticPaths() {
    const galleryEntries = await getCollection("gallery");
    return galleryEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

import { formatDateLong } from "../../utils/formatDate";

const { entry } = Astro.props;
const { Content } = await render(entry);

// Optimized variants: a 1200px card for the social/og image, plus
// width-capped large variants for every on-demand fullscreen image
// (capped to each source width so small originals are never upscaled).
const ogImage = await getImage({
    src: entry.data.image,
    width: Math.min(1200, entry.data.image.width),
    format: "webp",
    quality: 82,
});
const detailImages =
    entry.data.images && entry.data.images.length > 0
        ? entry.data.images
        : [entry.data.image];
const lightboxSources = await Promise.all(
    detailImages.map((src) =>
        getImage({
            src,
            width: Math.min(1800, src.width),
            format: "webp",
            quality: 82,
        }).then((result) => result.src),
    ),
);

const galleryDescription =
    [entry.data.title, entry.data.location, entry.data.camera]
        .filter(Boolean)
        .join(" · ") + " - Photography by Audiofool";
---

<MinimalLayout
    title={entry.data.title}
    section="Gallery"
    description={galleryDescription}
    image={ogImage.src}
    imageWidth={ogImage.attributes.width}
    imageHeight={ogImage.attributes.height}
    ogType="article"
    datePublished={entry.data.date}
>
    <div class="p-6 md:p-12" transition:animate="fade">
        <!-- Back Link -->
        <a
            href="/gallery/"
            class="font-mono text-sm text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors mb-8 inline-block"
        >
            ← Back to Gallery
        </a>

        <article class="max-w-4xl mx-auto">
            <!-- Primary image -->
            <div
                class="mb-8 border border-[var(--border-main)] overflow-hidden flex justify-center bg-[var(--bg-body)]"
            >
                <Image
                    id="gallery-image"
                    data-gallery-image="true"
                    data-lightbox-src={lightboxSources[0]}
                    src={detailImages[0]}
                    alt={entry.data.title}
                    width={1000}
                    widths={[480, 720, 1000, 1400]}
                    sizes="(min-width: 896px) 56rem, calc(100vw - 3rem)"
                    loading="eager"
                    fetchpriority="high"
                    role="button"
                    tabindex="0"
                    aria-label="View photo 1 full screen"
                    decoding="async"
                    quality={78}
                    class="max-h-[85vh] w-auto object-contain cursor-zoom-in transition-transform duration-300"
                />
            </div>

            <!-- Metadata -->
            <header class="mb-8 border-b border-[var(--border-main)] pb-6">
                <h1 class="text-3xl md:text-4xl font-bold font-heading mb-4">
                    {entry.data.title}
                </h1>

                <div
                    class="flex flex-wrap gap-6 text-sm font-mono text-[var(--text-muted)]"
                >
                    <div class="flex items-center gap-2">
                        <span class="text-[var(--text-faint)]">Date:</span>
                        <time>{formatDateLong(entry.data.date)}</time>
                    </div>
                    {
                        entry.data.location && (
                            <div class="flex items-center gap-2">
                                <span class="text-[var(--text-faint)]">Location:</span>
                                <span>{entry.data.location}</span>
                            </div>
                        )
                    }
                    {
                        entry.data.camera && (
                            <div class="flex items-center gap-2">
                                <span class="text-[var(--text-faint)]">Camera:</span>
                                <span>{entry.data.camera}</span>
                            </div>
                        )
                    }
                    {
                        entry.data.lens && (
                            <div class="flex items-center gap-2">
                                <span class="text-[var(--text-faint)]">Lens:</span>
                                <span>{entry.data.lens}</span>
                            </div>
                        )
                    }
                    {
                        entry.data.filmStock && (
                            <div class="flex items-center gap-2">
                                <span class="text-[var(--text-faint)]">Film:</span>
                                <span>{entry.data.filmStock}</span>
                            </div>
                        )
                    }
                    {
                        (entry.data.iso ||
                            entry.data.aperture ||
                            entry.data.shutterSpeed) && (
                            <div class="flex items-center gap-2">
                                <span class="text-[var(--text-faint)]">EXIF:</span>
                                <span>
                                    {[
                                        entry.data.focalLength,
                                        entry.data.aperture,
                                        entry.data.shutterSpeed,
                                        entry.data.iso
                                            ? `ISO ${entry.data.iso}`
                                            : null,
                                    ]
                                        .filter(Boolean)
                                        .join(" · ")}
                                </span>
                            </div>
                        )
                    }
                    <div class="flex items-center gap-2">
                        <span class="text-[var(--text-faint)]">Category:</span>
                        <span
                            class="px-2 py-0.5 border border-[var(--border-main)] text-xs"
                        >
                            {entry.data.category}
                        </span>
                    </div>
                </div>
            </header>

            <!-- Story Content -->
            <div class="post-content prose prose-lg max-w-none">
                <Content />
            </div>

            <!-- Additional images -->
            {
                detailImages.length > 1 && (
                    <div class="mt-8 space-y-6">
                        {detailImages.slice(1).map((src, index) => {
                            const imageIndex = index + 1;
                            return (
                                <div class="border border-[var(--border-main)] overflow-hidden flex justify-center bg-[var(--bg-body)]">
                                    <Image
                                        data-gallery-image="true"
                                        data-lightbox-src={lightboxSources[imageIndex]}
                                        src={src}
                                        alt={`${entry.data.title} - view ${imageIndex + 1} of ${detailImages.length}`}
                                        width={1000}
                                        widths={[480, 720, 1000, 1400]}
                                        sizes="(min-width: 896px) 56rem, calc(100vw - 3rem)"
                                        loading="lazy"
                                        fetchpriority="auto"
                                        role="button"
                                        tabindex="0"
                                        aria-label={`View photo ${imageIndex + 1} full screen`}
                                        decoding="async"
                                        quality={78}
                                        class="max-h-[85vh] w-auto object-contain cursor-zoom-in transition-transform duration-300"
                                    />
                                </div>
                            );
                        })}
                    </div>
                )
            }
        </article>
    </div>

    <!-- Lightbox Overlay (Moved outside transition container) -->
    <div
        id="lightbox"
        class="fixed inset-0 z-[9999] bg-black/95 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 cursor-zoom-out backdrop-blur-sm"
    >
        <img
            id="lightbox-image"
            src=""
            alt={entry.data.title}
            loading="lazy"
            decoding="async"
            class="max-h-[95vh] max-w-[95vw] object-contain shadow-2xl"
        />
    </div>

    <script is:inline>
        (function() {
            let escHandler = null;

            document.addEventListener("astro:page-load", () => {
                // Clean up previous ESC handler to prevent listener accumulation
                if (escHandler) {
                    document.removeEventListener("keydown", escHandler);
                    escHandler = null;
                }

                const galleryImages = Array.from(
                    document.querySelectorAll("[data-gallery-image]"),
                );
                const lightbox = document.getElementById("lightbox");
                const lightboxImage = document.getElementById("lightbox-image");
                let returnTarget = null;

                if (galleryImages.length > 0 && lightbox && lightboxImage) {
                    const openLightbox = (galleryImage) => {
                        const src = galleryImage.getAttribute("data-lightbox-src");
                        if (src && lightboxImage.getAttribute("src") !== src) {
                            lightboxImage.setAttribute("src", src);
                        }
                        returnTarget = galleryImage;
                        lightbox.classList.remove("opacity-0", "pointer-events-none");
                    };
                    const closeLightbox = () => {
                        const wasOpen = !lightbox.classList.contains("pointer-events-none");
                        lightbox.classList.add("opacity-0", "pointer-events-none");
                        if (wasOpen && returnTarget) returnTarget.focus();
                    };

                    galleryImages.forEach((galleryImage) => {
                        galleryImage.addEventListener("click", (e) => {
                            e.stopPropagation();
                            openLightbox(galleryImage);
                        });
                        galleryImage.addEventListener("keydown", (e) => {
                            if (e.key === "Enter" || e.key === " ") {
                                e.preventDefault();
                                openLightbox(galleryImage);
                            }
                        });
                    });

                    lightbox.addEventListener("click", closeLightbox);

                    escHandler = (e) => {
                        if (e.key === "Escape") closeLightbox();
                    };
                    document.addEventListener("keydown", escHandler);
                }
            });
        })();
    </script>
</MinimalLayout>
