---
import MinimalLayout from "../layouts/MinimalLayout.astro";
---

<MinimalLayout title="404 - Not Found">
    <div class="p-6 md:p-12" transition:animate="fade">
        <p class="font-mono text-xs uppercase tracking-widest text-[var(--text-muted)] mb-2">404</p>

        <h1 class="text-3xl md:text-4xl font-bold font-heading mb-4">
            “Is There Anybody Out There?”
        </h1>

        <p class="text-[var(--text-muted)] mb-10">
            The page you are looking for has been obscured by clouds.
        </p>

        <a
            href="/"
            class="inline-block py-1.5 -my-1.5 font-mono text-sm text-[var(--text-muted)] underline decoration-1 underline-offset-4 hover:text-[var(--text-main)] transition-colors"
        >
            Return home
        </a>
    </div>
</MinimalLayout>
