---
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { getCollection } from "astro:content";
import { formatDateCompact } from "../../utils/formatDate";

const wikiEntries = await getCollection("wiki");

// Sort by updatedDate desc (fallback to pubDate)
const sorted = [...wikiEntries].sort((a, b) => {
    const dateA = (
        a.data.updatedDate ||
        a.data.pubDate ||
        new Date(0)
    ).valueOf();
    const dateB = (
        b.data.updatedDate ||
        b.data.pubDate ||
        new Date(0)
    ).valueOf();
    return dateB - dateA;
});

const kindOrder = ["Concept", "Method", "Model", "Essay", "Reference"];
const kinds = new Set<string>(sorted.map((entry) => entry.data.kind));
const filters = kindOrder
    .filter((kind) => kinds.has(kind))
    .map((kind) => ({ key: kind.toLowerCase(), label: kind }));

function getDate(entry: (typeof sorted)[0]) {
    return entry.data.updatedDate || entry.data.pubDate;
}
---

<MinimalLayout title="Notes | Audiofool" description="Personal notes and working ideas">
    <div class="p-6 md:p-12 md:mb-20" transition:animate="fade">
        <header class="mb-10">
            <h1 class="text-4xl font-bold font-heading">Notes</h1>
        </header>

        <!-- Kind Filters -->
        <div class="mb-10">
            <div class="scroll-row font-mono text-sm">
                <button
                    type="button"
                    data-kind="all"
                    aria-pressed="true"
                    class="note-kind active whitespace-nowrap py-1.5 -my-1.5 transition-colors"
                >
                    <span aria-hidden="true">[ </span>All<span aria-hidden="true"> ]</span>
                </button>
                {
                    filters.map(({ key, label }) => (
                        <button
                            type="button"
                            data-kind={key}
                            aria-pressed="false"
                            class="note-kind whitespace-nowrap py-1.5 -my-1.5 transition-colors"
                        >
                            <span aria-hidden="true">[ </span>{label}<span aria-hidden="true"> ]</span>
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Entry List -->
        <div id="note-entries" class="max-w-2xl">
            {
                sorted.map((entry) => {
                    const date = getDate(entry);
                    return (
                        <a
                            href={`/notes/${entry.id}/`}
                            class="note-entry group block mb-8"
                            data-kind={entry.data.kind.toLowerCase()}
                        >
                            <p class="font-mono text-xs uppercase tracking-wider text-[var(--text-faint)]">
                                {date && (
                                    <>
                                        <time datetime={date.toISOString().split("T")[0]}>{formatDateCompact(date)}</time> ·{" "}
                                    </>
                                )}
                                {entry.data.kind}
                            </p>
                            <h2 class="mt-2 font-sans text-base font-semibold text-[var(--text-main)] group-hover:underline decoration-1 underline-offset-4">
                                {entry.data.title}
                            </h2>
                            {entry.data.description && (
                                <p class="mt-1 font-sans text-sm leading-relaxed text-[var(--text-muted)]">
                                    {entry.data.description}
                                </p>
                            )}
                        </a>
                    );
                })
            }
        </div>

        {
            sorted.length === 0 && (
                <div class="py-16 text-center text-[var(--text-muted)]">
                    No entries yet.
                </div>
            )
        }
    </div>
</MinimalLayout>

<style>
    .note-kind {
        color: var(--text-muted);
    }
    .note-kind:hover {
        color: var(--text-main);
    }
    .note-kind.active {
        color: var(--text-main);
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-thickness: 1px;
    }
</style>

<script>
    import { revealInRow } from "../../scripts/scrollRow";

    (function () {
        let cleanupFn: (() => void) | null = null;

        document.addEventListener("astro:page-load", () => {
            if (cleanupFn) {
                cleanupFn();
                cleanupFn = null;
            }

            const filters = document.querySelectorAll<HTMLElement>(".note-kind");
            const entries = document.querySelectorAll<HTMLElement>(".note-entry");
            if (!filters.length) return;

            function applyFilter(filter: string) {
                filters.forEach((t) => {
                    t.classList.remove("active");
                    t.setAttribute("aria-pressed", "false");
                });
                var btn = document.querySelector(
                    '.note-kind[data-kind="' + filter + '"]',
                );
                if (btn) {
                    btn.classList.add("active");
                    btn.setAttribute("aria-pressed", "true");
                    revealInRow(btn);
                }

                entries.forEach((entry) => {
                    entry.style.display =
                        filter === "all" || entry.dataset.kind === filter
                            ? ""
                            : "none";
                });
            }

            function onClick(e: Event) {
                if (!(e.currentTarget instanceof HTMLElement)) return;
                applyFilter(e.currentTarget.dataset.kind || "all");
            }

            filters.forEach((tab) => {
                tab.addEventListener("click", onClick);
            });

            // Auto-filter from URL query
            var urlKind = new URLSearchParams(window.location.search).get("kind");
            if (urlKind) applyFilter(urlKind.toLowerCase());

            cleanupFn = function () {
                filters.forEach((t) => t.removeEventListener("click", onClick));
            };
        });
    })();
</script>
