---
import { getCollection, render } from "astro:content";
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import "../../style/post.css";

export async function getStaticPaths() {
    const wikiEntries = await getCollection("wiki");
    return wikiEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Only ship the KaTeX stylesheet when the note actually contains math.
// Fall back to loading it if the raw body is unavailable, so math never breaks.
const hasMath = entry.body === undefined ? true : /\$/.test(entry.body);

// Resolve connections
const allWiki = await getCollection("wiki");
const lookup = new Map(allWiki.map((e) => [e.id, e]));

const parentEntries = (entry.data.parents || [])
    .map((id) => lookup.get(id.toLowerCase()))
    .filter(Boolean) as (typeof allWiki)[number][];

const relatedEntries = (entry.data.related || [])
    .map((id) => lookup.get(id.toLowerCase()))
    .filter(Boolean) as (typeof allWiki)[number][];

// Incoming references (entries that link to this one)
const referencedBy = allWiki.filter(
    (e) =>
        e.id !== entry.id &&
        [...(e.data.parents || []), ...(e.data.related || [])]
            .map((id) => id.toLowerCase())
            .includes(entry.id),
);

// Deduplicate across all three
const seen = new Set<string>();
const allConnections: {
    entry: (typeof allWiki)[number];
    type: "parent" | "related" | "incoming";
}[] = [];

for (const e of parentEntries) {
    if (!seen.has(e.id)) {
        seen.add(e.id);
        allConnections.push({ entry: e, type: "parent" });
    }
}
for (const e of relatedEntries) {
    if (!seen.has(e.id)) {
        seen.add(e.id);
        allConnections.push({ entry: e, type: "related" });
    }
}
for (const e of referencedBy) {
    if (!seen.has(e.id)) {
        seen.add(e.id);
        allConnections.push({ entry: e, type: "incoming" });
    }
}

const noteDescription =
    entry.data.description ??
    `${entry.data.kind} · ${entry.data.title}${entry.data.tags.length ? " - " + entry.data.tags.join(", ") : ""}`;

const ogImage =
    typeof entry.data.image === "string"
        ? entry.data.image
        : entry.data.image?.url;
const ogImageAlt = ogImage
    ? (typeof entry.data.image === "object" && entry.data.image.alt) ||
      entry.data.title
    : undefined;

// Header dates: "Published" only when it adds information beyond "Updated".
const toISODate = (date: Date) => date.toISOString().split("T")[0];
const updatedISO = entry.data.updatedDate && toISODate(entry.data.updatedDate);
const publishedISO = entry.data.pubDate && toISODate(entry.data.pubDate);
const headerDates: { label: string; date: string }[] = [];
if (publishedISO && publishedISO !== updatedISO) {
    headerDates.push({ label: "Published", date: publishedISO });
}
if (updatedISO) {
    headerDates.push({ label: "Updated", date: updatedISO });
}
---

<MinimalLayout
    title={entry.data.title}
    section="Notes"
    description={noteDescription}
    image={ogImage}
    imageAlt={ogImageAlt}
    ogType="article"
    math={hasMath}
    datePublished={entry.data.pubDate}
    dateModified={entry.data.updatedDate}
>
    <!-- Breadcrumb: a sticky band from md up; a quiet back link on phones, where the H1 already names the page. -->
    <div
        class="md:border-b border-[var(--border-main)] bg-[var(--bg-body)] md:sticky md:top-0 md:z-10"
    >
        <div
            class="max-w-[44rem] mx-auto px-6 md:px-12 pt-3 md:py-3 font-mono text-xs text-[var(--text-muted)] flex items-center gap-2"
        >
            <a
                href="/notes/"
                class="py-3 md:py-0 hover:text-[var(--text-main)] transition-colors"
                ><span aria-hidden="true" class="md:hidden">← </span>Notes</a
            >
            <span class="hidden md:block opacity-30">/</span>
            <span class="hidden md:block text-[var(--text-main)] truncate"
                >{entry.data.title}</span
            >
        </div>
    </div>

    <!-- Main Content -->
    <article
        class="p-6 md:p-12 max-w-[44rem] mx-auto"
        transition:animate="fade"
    >
        <header class="mb-12 border-b border-[var(--border-main)] pb-6">
            <h1 class="text-3xl md:text-4xl font-bold font-heading mb-4">
                {entry.data.title}
            </h1>

            <div class="flex flex-wrap gap-3 items-center justify-between">
                <div class="flex flex-wrap items-center gap-2">
                    <a
                        href={`/notes/?kind=${entry.data.kind.toLowerCase()}`}
                        class="text-xs font-mono text-[var(--text-main)] px-1.5 py-0.5 border border-[var(--border-main)] hover:bg-[var(--text-main)] hover:text-[var(--bg-body)] transition-colors"
                    >
                        {entry.data.kind}
                    </a>
                    {
                        entry.data.tags.map((tag) => (
                            <span class="text-xs font-mono text-[var(--text-faint)] px-1 py-0.5">
                                {tag.toLowerCase()}
                            </span>
                        ))
                    }
                </div>

                {
                    headerDates.length > 0 && (
                        <div class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-[var(--text-faint)]">
                            {headerDates.map(({ label, date }) => (
                                <span>
                                    {label} <time datetime={date}>{date}</time>
                                </span>
                            ))}
                        </div>
                    )
                }
            </div>
        </header>

        <div
            class="post-content wiki-content prose max-w-none prose-headings:font-heading prose-a:text-[var(--text-main)] prose-code:font-mono"
        >
            <Content />
        </div>

        <!-- Connected Nodes -->
        {
            allConnections.length > 0 && (
                <div class="mt-20 pt-8 border-t border-[var(--border-main)]">
                    <h2 class="font-mono text-xs uppercase mb-6 text-[var(--text-muted)] tracking-wider">
                        Connected Nodes · {allConnections.length}
                    </h2>
                    <div class="space-y-1">
                        {allConnections.map(({ entry: e, type }) => (
                            <a
                                href={`/notes/${e.id}/`}
                                class="flex items-center gap-3 py-2.5 px-3 -mx-3 text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors group border-b border-transparent hover:border-[var(--border-subtle)]"
                            >
                                <span class="font-mono text-[10px] text-[var(--text-faint)] w-4 flex-shrink-0">
                                    {type === "parent"
                                        ? "↑"
                                        : type === "related"
                                          ? "↔"
                                          : "←"}
                                </span>
                                <span class="text-sm group-hover:underline decoration-1 underline-offset-4">
                                    {e.data.title}
                                </span>
                                <span class="font-mono text-[11px] text-[var(--text-faint)] ml-auto flex-shrink-0">
                                    {type}
                                </span>
                            </a>
                        ))}
                    </div>
                </div>
            )
        }
    </article>
</MinimalLayout>
