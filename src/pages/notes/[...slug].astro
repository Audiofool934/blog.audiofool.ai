---
import { getCollection, render } from "astro:content";
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { formatDateLong } from "../../utils/formatDate";
import "../../style/post.css";

export async function getStaticPaths() {
    const wikiEntries = await getCollection("wiki");
    return wikiEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Only ship the KaTeX stylesheet when the note actually contains math.
// Fall back to loading it if the raw body is unavailable, so math never breaks.
const hasMath = entry.body === undefined ? true : /\$/.test(entry.body);

// Resolve connections
const allWiki = await getCollection("wiki");
const lookup = new Map(allWiki.map((e) => [e.id, e]));

const parentEntries = (entry.data.parents || [])
    .map((id) => lookup.get(id.toLowerCase()))
    .filter(Boolean) as (typeof allWiki)[number][];

const relatedEntries = (entry.data.related || [])
    .map((id) => lookup.get(id.toLowerCase()))
    .filter(Boolean) as (typeof allWiki)[number][];

// Incoming references (entries that link to this one)
const referencedBy = allWiki.filter(
    (e) =>
        e.id !== entry.id &&
        [...(e.data.parents || []), ...(e.data.related || [])]
            .map((id) => id.toLowerCase())
            .includes(entry.id),
);

// Deduplicate across all three, parents first
const seen = new Set<string>();
const allConnections = [...parentEntries, ...relatedEntries, ...referencedBy].filter((e) => {
    if (seen.has(e.id)) return false;
    seen.add(e.id);
    return true;
});

const noteDescription =
    entry.data.description ??
    `${entry.data.kind} · ${entry.data.title}${entry.data.tags.length ? " - " + entry.data.tags.join(", ") : ""}`;

const ogImage =
    typeof entry.data.image === "string"
        ? entry.data.image
        : entry.data.image?.url;
const ogImageAlt = ogImage
    ? (typeof entry.data.image === "object" && entry.data.image.alt) ||
      entry.data.title
    : undefined;

// Header dates: "Published" only when it adds information beyond "Updated".
const toISODate = (date: Date) => date.toISOString().split("T")[0];
const { pubDate, updatedDate, tags } = entry.data;
const headerDates: { label: string; date: Date }[] = [];
if (pubDate && (!updatedDate || toISODate(pubDate) !== toISODate(updatedDate))) {
    headerDates.push({ label: "Published", date: pubDate });
}
if (updatedDate) {
    headerDates.push({ label: "Updated", date: updatedDate });
}
---

<MinimalLayout
    title={entry.data.title}
    section="Notes"
    description={noteDescription}
    image={ogImage}
    imageAlt={ogImageAlt}
    ogType="article"
    math={hasMath}
    datePublished={entry.data.pubDate}
    dateModified={entry.data.updatedDate}
>
    <!-- Back link on phones only; from md up the sidebar marks and links the section. -->
    <div
        class="md:hidden max-w-[44rem] mx-auto px-6 pt-3 font-mono text-sm text-[var(--text-muted)]"
    >
        <a
            href="/notes/"
            class="inline-block py-3 hover:text-[var(--text-main)] transition-colors"
            ><span aria-hidden="true">← </span>Notes</a
        >
    </div>

    <!-- Main Content -->
    <article
        class="p-6 md:p-12 max-w-[44rem] mx-auto"
        transition:animate="fade"
    >
        <header class="mb-10">
            <h1 class="text-3xl md:text-4xl font-bold font-heading mb-4">
                {entry.data.title}
            </h1>

            {/* One line in reading order: kind · tags · dates. Separators end each field, so a wrapped line never starts with one. */}
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-2 font-mono text-xs text-[var(--text-faint)]">
                <span class="whitespace-nowrap">
                    <a
                        href={`/notes/?kind=${entry.data.kind.toLowerCase()}`}
                        class="inline-block py-1 -my-1 text-[var(--text-muted)] underline decoration-1 underline-offset-4 hover:text-[var(--text-main)] transition-colors"
                    >{entry.data.kind}</a>{(tags.length > 0 || headerDates.length > 0) && " ·"}
                </span>
                {
                    tags.map((tag, i) => (
                        <span class="whitespace-nowrap">
                            {tag}{i < tags.length - 1 ? "," : headerDates.length > 0 && " ·"}
                        </span>
                    ))
                }
                {
                    headerDates.map(({ label, date }, i) => (
                        <span class="whitespace-nowrap">
                            {label} <time datetime={toISODate(date)}>{formatDateLong(date)}</time>{i < headerDates.length - 1 && " ·"}
                        </span>
                    ))
                }
            </div>
        </header>

        <div
            class="post-content wiki-content prose max-w-none prose-headings:font-heading prose-a:text-[var(--text-main)] prose-code:font-mono"
        >
            <Content />
        </div>

        <!-- Related notes -->
        {
            allConnections.length > 0 && (
                <div class="mt-16">
                    <h2 class="font-mono text-xs uppercase tracking-widest mb-3 text-[var(--text-muted)]">
                        Related notes
                    </h2>
                    <div class="space-y-1">
                        {allConnections.map((e) => (
                            <a
                                href={`/notes/${e.id}/`}
                                class="group block py-2.5 text-sm text-[var(--text-main)]"
                            >
                                <span class="group-hover:underline decoration-1 underline-offset-4">
                                    {e.data.title}
                                </span>
                            </a>
                        ))}
                    </div>
                </div>
            )
        }
    </article>
</MinimalLayout>
