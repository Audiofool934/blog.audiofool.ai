---
import MinimalLayout from "../layouts/MinimalLayout.astro";
import { formatDateCompact } from "../utils/formatDate";
import { getLatestWriting } from "../utils/timelineItems";

const writingPosts = await getLatestWriting(3);

// Widths produced by scripts/generate-site-images.mjs for the homepage portraits.
const portraitWidths = [320, 480, 640, 960, 1280];
const srcset = (name: string, format: "avif" | "webp") =>
	portraitWidths.map((width) => `/images/_generated/site/${name}-${width}.${format} ${width}w`).join(", ");

// Each theme shows one portrait. Both are lazy so the hidden one is never downloaded.
const portraits = [
	{
		// Dark theme: a night cutout, feathered by the alpha matte baked in by the image generator.
		name: "audiofool-portrait",
		width: 960,
		height: 960,
		sizes: "min(64vw, 280px)",
		class: "index-portrait-night hidden dark:block",
	},
	{
		// Light theme: a film frame, shown whole with its rebate.
		name: "audiofool-film-portrait",
		width: 960,
		height: 828,
		sizes: "(min-width: 768px) 324px, min(calc(100vw - 4rem), 420px)",
		class: "index-portrait-film block dark:hidden",
	},
];
---

<MinimalLayout title="Audiofool — Creative AI, Notes, AudioShow & Photography">
	<div class="index-hero flex flex-col justify-start md:justify-center px-8 pt-6 pb-10 md:p-12" transition:animate="fade">
		<!-- The sidebar and top bar already show "Audiofool", so the page heading is for screen readers only. -->
		<h1 class="sr-only">Audiofool</h1>

		<!-- Stacked below xl: portrait on top. From xl: text on the left, portrait on the right. -->
		<div class="index-layout flex flex-col items-center gap-8 xl:flex-row-reverse xl:items-center xl:justify-between xl:gap-12">
			<div class="index-portrait pointer-events-none">
				{
					portraits.map((portrait) => (
						<picture class="contents">
							<source type="image/avif" srcset={srcset(portrait.name, "avif")} sizes={portrait.sizes} />
							<img
								src={`/images/_generated/site/${portrait.name}-960.webp`}
								srcset={srcset(portrait.name, "webp")}
								sizes={portrait.sizes}
								alt=""
								width={portrait.width}
								height={portrait.height}
								loading="lazy"
								fetchpriority="high"
								decoding="async"
								class:list={[portrait.class, "w-full h-auto"]}
							/>
						</picture>
					))
				}
			</div>

			<div class="w-full max-w-2xl min-w-0">
				<div class="text-[var(--text-muted)] text-base md:text-lg leading-relaxed space-y-5 index-intro">
					<p>
						I am <strong>Yinbo Wang</strong>.<br />
						I build and study <strong>creative AI</strong>, with a focus on
						<strong>multimodal understanding/generation</strong> and
						<strong>AI agent</strong>.
					</p>
					<p>
						The <a href="/timeline/">timeline</a> is a chronological trace of notes, projects, music, photos, and site changes. <a href="/projects/">Projects</a> collects what I’m building. <a href="/notes/">Notes</a> holds math, AI/ML, and ideas in progress. <a href="/audioshow/">AudioShow</a> is my long-running music journal — 200+ song episodes and curated listening crates. <a href="/gallery/">Gallery</a> keeps selected photographs I took.
					</p>
				</div>

				{
					writingPosts.length > 0 && (
						<section class="mt-12 index-news">
							<div class="flex items-baseline gap-4 mb-3">
								<h2 class="font-mono text-xs uppercase tracking-widest text-[var(--text-muted)]">
									Writing
								</h2>
								<a
									href="/timeline/"
									class="font-mono text-xs text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
								>
									[ View timeline ]
								</a>
							</div>

							<div class="space-y-1.5">
								{writingPosts.map((post) => {
									const type = post.lane;
									return (
										<a
											href={post.href}
											class="group block text-xs md:text-sm text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
										>
											<span class="font-mono uppercase tracking-wider text-[var(--text-faint)]">
												{formatDateCompact(post.date)} · {type}
											</span>
											<span class="mx-2 opacity-35">—</span>
											<span class="text-[var(--text-main)] group-hover:underline decoration-1 underline-offset-4">
												{post.title}
											</span>
										</a>
									);
								})}
							</div>
						</section>
					)
				}
			</div>
		</div>
	</div>
</MinimalLayout>

<style>
	.index-hero {
		min-height: calc(100vh - 160px); /* mobile: nav + bottom player */
	}
	@media (min-width: 768px) {
		.index-hero {
			min-height: calc(100vh - 2rem);
		}
	}

	/* Phones: the square night cutout stays compact; the landscape film frame fills more of the column. */
	.index-portrait {
		flex: none;
		width: min(64vw, 280px);
	}
	:global(html:not(.dark)) .index-portrait {
		width: min(100%, 420px);
	}
	/* Larger screens: cap both portraits at 280px tall (the film frame is 960×828). */
	@media (min-width: 768px) {
		.index-portrait {
			width: 280px;
		}
		:global(html:not(.dark)) .index-portrait {
			width: 324px;
		}
	}

	.index-intro strong {
		color: var(--text-main);
		font-weight: 700;
	}

	.index-intro a {
		color: var(--text-main);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: all 0.2s ease;
	}
	.index-intro a:hover {
		background-color: var(--text-main);
		color: var(--bg-body);
		text-decoration: none;
	}
</style>
