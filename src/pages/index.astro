---
import MinimalLayout from "../layouts/MinimalLayout.astro";
import { formatDateCompact } from "../utils/formatDate";
import { getTimelineItems } from "../utils/timelineItems";

const timelinePosts = (await getTimelineItems()).slice(0, 3);
---

<MinimalLayout title="Audiofool — Creative AI, Notes, AudioShow & Photography">
	<div class="index-hero relative overflow-clip flex flex-col" transition:animate="fade">
		<!-- Background -->
		<div class="index-portrait absolute bottom-0 right-0 pointer-events-none max-w-[56%] md:max-w-[42.5%]">
			<picture class="contents">
				<source
					type="image/avif"
					srcset="/images/_generated/site/audiofool-portrait-320.avif 320w, /images/_generated/site/audiofool-portrait-480.avif 480w, /images/_generated/site/audiofool-portrait-640.avif 640w, /images/_generated/site/audiofool-portrait-960.avif 960w, /images/_generated/site/audiofool-portrait-1280.avif 1280w"
					sizes="(min-width: 1440px) 503px, (min-width: 768px) calc((100vw - 256px) * 0.425), 56vw"
				/>
			<img
				src="/images/_generated/site/audiofool-portrait-960.webp"
				srcset="/images/_generated/site/audiofool-portrait-320.webp 320w, /images/_generated/site/audiofool-portrait-480.webp 480w, /images/_generated/site/audiofool-portrait-640.webp 640w, /images/_generated/site/audiofool-portrait-960.webp 960w, /images/_generated/site/audiofool-portrait-1280.webp 1280w"
				sizes="(min-width: 1440px) 503px, (min-width: 768px) calc((100vw - 256px) * 0.425), 56vw"
				alt=""
				width="960"
				height="960"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="w-full h-full object-cover object-right-bottom opacity-50"
			/>
			</picture>
			<div class="absolute inset-0 bg-gradient-to-br from-[var(--bg-body)] via-transparent to-transparent"></div>
		</div>

		<!-- Content -->
		<div class="relative p-8 md:p-12 flex-1 flex flex-col justify-start pt-[15%] md:pt-[12%]">
			<h1
				class="flex items-center gap-4 md:gap-6 text-4xl md:text-6xl font-bold tracking-tight font-heading mb-12 md:mb-16"
			>
				<span>Audiofool</span>
				<img
					src="/images/_generated/site/audiofool-seal-112.webp"
					alt=""
					width="112"
					height="112"
					loading="eager"
					decoding="async"
					class="audiofool-seal h-11 w-11 md:h-14 md:w-14 shrink-0 opacity-90"
					aria-hidden="true"
				/>
			</h1>
			<div class="max-w-2xl text-[var(--text-muted)] text-base md:text-lg leading-relaxed space-y-5 index-intro">
				<p>
					I build and study <strong>creative AI</strong>, with a focus on
					<strong>multimodal understanding/generation</strong> and
					<strong>AI agent</strong>.
				</p>
				<p>
					The <a href="/timeline/">timeline</a> is a chronological trace of notes, projects, music, photos, and site changes. <a href="/projects/">Projects</a> collects what I’m building. <a href="/notes/">Notes</a> holds math, AI/ML, and ideas in progress. <a href="/audioshow/">AudioShow</a> is my long-running music journal — 200+ song episodes and curated listening crates. <a href="/gallery/">Gallery</a> keeps selected photographs I took.
				</p>
			</div>

			{
				timelinePosts.length > 0 && (
					<section class="mt-12 md:mt-16 max-w-3xl index-news">
						<div class="flex items-baseline gap-4 mb-3">
							<h2 class="font-mono text-xs uppercase tracking-widest text-[var(--text-muted)]">
								Updates
							</h2>
							<a
								href="/timeline/"
								class="font-mono text-xs text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
							>
								[ View timeline ]
							</a>
						</div>

						<div class="space-y-1.5">
							{timelinePosts.map((post) => {
								const type = post.lane;
								return (
									<a
										href={post.href}
										class="group block text-xs md:text-sm text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
									>
										<span class="font-mono uppercase tracking-wider text-[var(--text-faint)]">
											{formatDateCompact(post.date)} · {type}
										</span>
										<span class="mx-2 opacity-35">—</span>
										<span class="text-[var(--text-main)] group-hover:underline decoration-1 underline-offset-4">
											{post.title}
										</span>
									</a>
								);
							})}
						</div>
					</section>
				)
			}
		</div>
	</div>
</MinimalLayout>

<style>
	.index-hero {
		min-height: calc(100vh - 160px); /* mobile: nav + bottom player */
	}
	@media (min-width: 768px) {
		.index-hero {
			min-height: calc(100vh - 2rem);
		}
	}

	.index-portrait {
		/* Crop the right side while keeping the visible photograph in the corner. */
		--portrait-crop-right: 15%;
		clip-path: inset(0 var(--portrait-crop-right) 0 0);
		transform: translateX(var(--portrait-crop-right));
	}

	.index-portrait img {
		/* Feather outside the supplied contour; preserve the complete foreground. */
		--portrait-mask:
			url("/images/audiofool-portrait-mask.svg"),
			linear-gradient(to bottom, transparent, rgb(0 0 0 / 0.08) 4%, rgb(0 0 0 / 0.3) 8%, rgb(0 0 0 / 0.65) 13%, #000 20%),
			linear-gradient(to right, transparent, rgb(0 0 0 / 0.2) 2%, rgb(0 0 0 / 0.8) 4%, #000 6%);
		-webkit-mask-image: var(--portrait-mask);
		mask-image: var(--portrait-mask);
		-webkit-mask-composite: source-in;
		mask-composite: intersect;
		mask-size: 100% 100%;
		mask-repeat: no-repeat;
	}

	.audiofool-seal {
		border-radius: 9999px;
		filter: invert(1);
		image-rendering: auto;
	}

	:global(html.dark) .audiofool-seal {
		filter: none;
		opacity: 0.86;
	}

	.index-intro strong {
		color: var(--text-main);
		font-weight: 700;
	}

	.index-intro a {
		color: var(--text-main);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: all 0.2s ease;
	}
	.index-intro a:hover {
		background-color: var(--text-main);
		color: var(--bg-body);
		text-decoration: none;
	}
</style>
