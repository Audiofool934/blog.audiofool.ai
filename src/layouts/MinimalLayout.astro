---
import "../style/global.css";
import "../style/prism-theme.css";
import SiteHead from "../components/site/SiteHead.astro";
import SiteSidebar from "../components/site/SiteSidebar.astro";
import SiteThemeScripts from "../components/site/SiteThemeScripts.astro";
import { getDefaultAudioTrack } from "../utils/defaultAudioTrack";

interface Props {
    /** The page's own title, without a " | Section" suffix. */
    title: string;
    /** Site section for detail pages; adds " | Section | Audiofool" to the document title. */
    section?: string;
    description?: string;
    lang?: string;
    /** Share image, site-relative or absolute. Omit it to use the default seal card. */
    image?: string;
    imageAlt?: string;
    imageWidth?: number;
    imageHeight?: number;
    ogType?: string;
    math?: boolean;
    datePublished?: Date;
    dateModified?: Date;
}

const {
    title,
    section,
    description = "Audiofool — creative AI, notes, an AudioShow music journal, and photography.",
    lang = "en",
    image,
    imageAlt,
    imageWidth,
    imageHeight,
    ogType = "website",
    math = false,
    datePublished,
    dateModified,
} = Astro.props;

const defaultTrackData = getDefaultAudioTrack();
---

<!doctype html>
<html lang={lang} class="scroll-smooth dark">
    <head>
        <SiteHead
            title={title}
            section={section}
            description={description}
            image={image}
            imageAlt={imageAlt}
            imageWidth={imageWidth}
            imageHeight={imageHeight}
            ogType={ogType}
            math={math}
            datePublished={datePublished}
            dateModified={dateModified}
        />
        <SiteThemeScripts />
    </head>
    <body class="min-h-screen flex flex-col font-sans bg-[var(--bg-body)] text-[var(--text-main)] transition-colors duration-300">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[300] focus:bg-[var(--bg-body)] focus:text-[var(--text-main)] focus:border focus:border-[var(--border-main)] focus:px-3 focus:py-2 focus:font-mono focus:text-sm">
            Skip to content
        </a>
        <!-- The side borders frame the centered column; below 1441px they would sit on the screen edges. -->
        <!-- Below md, the bottom padding clears the fixed player and the iPhone home indicator. -->
        <div class="min-h-screen flex flex-col md:flex-row max-w-[1440px] mx-auto w-full min-[1441px]:border-x border-[var(--border-main)] pb-[calc(5rem+env(safe-area-inset-bottom))] md:pb-0">
            <SiteSidebar />
            <main id="main-content" tabindex="-1" class="flex-1 min-w-0 w-full outline-none">
                <slot />
            </main>
        </div>

        <script>
            function applyTheme() {
                const html = document.documentElement;
                const dark = localStorage.getItem("theme") !== "light";
                html.classList.toggle("dark", dark);
                // A page swap restores the built theme-color, so match the browser bar to the theme again.
                document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#0a0a0a" : "#fafafa");
                syncThemeControls();
            }

            function syncThemeControls() {
                const isDark = document.documentElement.classList.contains("dark");
                const nextTheme = isDark ? "light" : "dark";
                const label = `Switch to ${nextTheme} theme`;

                document.querySelectorAll("[data-theme-toggle]").forEach((control) => {
                    control.setAttribute("aria-label", label);
                    control.setAttribute("title", label);
                });
            }

            function attachToggle() {
                const themeToggles = document.querySelectorAll<HTMLElement>("[data-theme-toggle]");
                const menuToggle = document.getElementById("mobile-menu-toggle");
                const menuIcon = document.getElementById("menu-icon");
                const navContent = document.getElementById("nav-content");
                const html = document.documentElement;

                const toggleTheme = () => {
                    const nextTheme = html.classList.contains("dark") ? "light" : "dark";
                    localStorage.setItem("theme", nextTheme);
                    applyTheme();
                };

                themeToggles.forEach((themeToggle) => {
                    themeToggle.onclick = toggleTheme;
                });
                syncThemeControls();

                if (menuToggle && navContent && menuIcon) {
                    const closeMenu = () => {
                        navContent.classList.add("hidden");
                        navContent.classList.remove("flex");
                        menuIcon.textContent = "[ ≡ ]";
                        menuToggle.setAttribute("aria-expanded", "false");
                    };
                    menuToggle.onclick = () => {
                        const isHidden = navContent.classList.contains("hidden");
                        if (isHidden) {
                            navContent.classList.remove("hidden");
                            navContent.classList.add("flex");
                            menuIcon.textContent = "[ × ]";
                            menuToggle.setAttribute("aria-expanded", "true");
                        } else {
                            closeMenu();
                        }
                    };
                    navContent.querySelectorAll(".nav-link").forEach((link) => {
                        link.addEventListener("click", closeMenu);
                    });
                }
            }

            function focusMain() {
                const main = document.getElementById("main-content");
                if (main) main.focus({ preventScroll: true });
            }

            document.addEventListener("astro:after-swap", applyTheme);
            document.addEventListener("astro:after-swap", focusMain);
            document.addEventListener("astro:page-load", attachToggle);
            document.addEventListener("astro:before-preparation", () => {
                window.scrollTo({ top: 0, behavior: "instant" });
            });
        </script>

        <script is:inline define:vars={{ defaultTrackData }}>
            if (defaultTrackData) {
                window.__defaultAudioShowTrack = defaultTrackData;
            }
        </script>
    </body>
</html>
